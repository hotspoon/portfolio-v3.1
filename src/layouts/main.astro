---
import "@/styles/global.css"

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hamzah Al Farisi",
  url: "https://www.hamzahalfarisi.web.id/",
  image: "https://www.hamzahalfarisi.web.id/og-image.svg",
  jobTitle: "Front-End Developer",
  description:
    "Frontend Developer focused on building reliable web products for banking, payments, and business systems with strong attention to performance, testing, and maintainable UI architecture.",
  email: "mailto:fariez8@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Jakarta",
    addressCountry: "Indonesia",
  },
  sameAs: [
    "https://www.linkedin.com/in/hamzah-al-farisi",
    "https://github.com/hotspoon",
    "https://www.hamzahalfarisi.web.id/",
  ],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Politeknik Elektronika Negeri Surabaya",
  },
  knowsAbout: [
    "Frontend Development",
    "React",
    "Next.js",
    "Vue",
    "TypeScript",
    "Testing",
    "Performance Optimization",
    "Banking Systems",
    "Payment Systems",
    "Web Accessibility",
  ],
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Hamzah Al Farisi" />
    <meta name="theme-color" content="#f7f2ea" />
    <meta
      name="description"
      content="Hamzah Al Farisi is a Front-End Developer focused on building reliable web products for banking, payments, and business systems with strong attention to performance, testing, and maintainable UI architecture."
    />
    <link rel="canonical" href="https://www.hamzahalfarisi.web.id/" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hamzah Al Farisi" />
    <meta property="og:title" content="Hamzah Al Farisi | Front-End Developer" />
    <meta
      property="og:description"
      content="Frontend Developer focused on reliable web products for banking, payments, and business systems."
    />
    <meta property="og:url" content="https://www.hamzahalfarisi.web.id/" />
    <meta property="og:image" content="https://www.hamzahalfarisi.web.id/og-image.svg" />
    <meta property="og:image:alt" content="Hamzah Al Farisi portfolio preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hamzah Al Farisi | Front-End Developer" />
    <meta
      name="twitter:description"
      content="Frontend Developer focused on reliable web products for banking, payments, and business systems."
    />
    <meta name="twitter:image" content="https://www.hamzahalfarisi.web.id/og-image.svg" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}></script>
    <title>Hamzah Al Farisi | Front-End Developer</title>
  </head>
  <body>
    <slot />
    <button
      type="button"
      class="pointer-events-none fixed right-4 bottom-4 z-50 inline-flex translate-y-4 items-center gap-2 rounded-full border border-[#1b1b1b]/10 bg-white/92 px-4 py-3 text-sm font-semibold text-[#1b1b1b] opacity-0 shadow-[0_16px_38px_rgba(19,25,38,0.14)] backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#8f4714] sm:right-6 sm:bottom-6 hover:cursor-pointer"
      aria-label="Back to navigation"
      data-scroll-top-button
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 19V5"></path>
        <path d="M6 11l6-6 6 6"></path>
      </svg>
      <span>Navbar</span>
    </button>
    <script>
      const initGlobalReveal = () => {
        const items = document.querySelectorAll("[data-reveal]")

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return

              entry.target.classList.add("is-visible")
              observer.unobserve(entry.target)
            })
          },
          {
            threshold: 0.16,
            rootMargin: "0px 0px -8% 0px",
          }
        )

        items.forEach((item) => {
          if (item.classList.contains("is-visible")) return
          observer.observe(item)
        })
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initGlobalReveal, {
          once: true,
        })
      } else {
        initGlobalReveal()
      }

      document.addEventListener("astro:page-load", initGlobalReveal)

      const initStickyNavbarState = () => {
        const wrappers = document.querySelectorAll("[data-sticky-nav-shell]")

        const updateState = () => {
          const isScrolled = window.scrollY > 24

          wrappers.forEach((wrapper) => {
            if (!(wrapper instanceof HTMLElement)) return

            wrapper.classList.toggle("border-transparent", !isScrolled)
            wrapper.classList.toggle("bg-transparent", !isScrolled)
            wrapper.classList.toggle("shadow-none", !isScrolled)
            wrapper.classList.toggle("backdrop-blur-none", !isScrolled)

            wrapper.classList.toggle("border-white/30", isScrolled)
            wrapper.classList.toggle("bg-white/18", isScrolled)
            wrapper.classList.toggle("shadow-[0_10px_28px_rgba(22,18,10,0.05)]", isScrolled)
            wrapper.classList.toggle("backdrop-blur-[14px]", isScrolled)
          })
        }

        updateState()
        window.addEventListener("scroll", updateState, { passive: true })
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initStickyNavbarState, {
          once: true,
        })
      } else {
        initStickyNavbarState()
      }

      document.addEventListener("astro:page-load", initStickyNavbarState)

      const initScrollTopButton = () => {
        const button = document.querySelector("[data-scroll-top-button]")
        const topTarget = document.querySelector("#home")

        if (!(button instanceof HTMLButtonElement)) return
        if (!(topTarget instanceof HTMLElement)) return

        const updateVisibility = () => {
          const shouldShow = window.scrollY > 220
          button.classList.toggle("pointer-events-none", !shouldShow)
          button.classList.toggle("opacity-0", !shouldShow)
          button.classList.toggle("translate-y-4", !shouldShow)
          button.classList.toggle("opacity-100", shouldShow)
          button.classList.toggle("translate-y-0", shouldShow)
        }

        if (button.dataset.scrollTopReady !== "true") {
          button.dataset.scrollTopReady = "true"
          button.addEventListener("click", () => {
            topTarget.scrollIntoView({ behavior: "smooth", block: "start" })
          })
        }

        updateVisibility()
        window.addEventListener("scroll", updateVisibility, { passive: true })
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollTopButton, {
          once: true,
        })
      } else {
        initScrollTopButton()
      }

      document.addEventListener("astro:page-load", initScrollTopButton)
    </script>
  </body>
</html>
