---
import textureBg from "@/assets/img/service-bg.png"

const testimonials = [
  {
    name: "Enterprise Delivery",
    role: "Frontend Engineering Focus",
    rating: 5,
    quote:
      "Experienced in building frontend features for banking and payment systems, including transaction-heavy flows that require reliability, maintainability, and careful integration work.",
  },
  {
    name: "Testing Mindset",
    role: "Quality & Reliability",
    rating: 5,
    quote:
      "Strong hands-on work with Jest and React Testing Library, with practical experience reducing bugs, improving validation quality, and making releases safer for product teams.",
  },
  {
    name: "Reusable Systems",
    role: "Scalable Frontend Approach",
    rating: 5,
    quote:
      "Focused on reusable UI components, API integration layers, and maintainable code structure across React, Next.js, Vue, and enterprise product environments.",
  },
]

const stars = Array.from({ length: 5 })
---

<section
  class="relative overflow-hidden rounded-[1.9rem] px-4 py-10 text-white sm:rounded-[3rem] sm:px-6 sm:py-12 lg:px-8"
  style={`background-image: url(${textureBg.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 bg-[#121212]/82"></div>
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.02)_0%,rgba(255,255,255,0)_100%)]"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px]">
    <div class="mx-auto max-w-[760px] text-center">
      <h2
        class="text-[2.3rem] leading-[1.08] font-black tracking-[-0.07em] text-white sm:text-[4rem]"
      >
        Testimonials That
        <span class="relative inline-block">
          <span
            class="absolute -top-3 -right-5 hidden text-[2.1rem] text-white sm:block"
            >〴</span
          >
          <span
            class="absolute -top-6 -right-4 hidden text-[1.5rem] text-white sm:block"
            >〳</span
          >
          <span
            class="absolute -top-4 -right-2 hidden text-[1.15rem] text-white sm:block"
            >〵</span
          >
        </span>
        <br />
        Speak to <span class="text-[#f58a3a]">My Results</span>
      </h2>

      <p
        class="mx-auto mt-4 max-w-[760px] text-[0.95rem] leading-[1.55] text-white/78 sm:mt-5 sm:text-[1.05rem] sm:leading-[1.45]"
      >
        A quick snapshot of the strengths highlighted throughout my frontend
        experience, from enterprise product delivery and testing quality to
        reusable architecture and performance-minded implementation.
      </p>
    </div>

    <div
      class="pointer-events-none absolute top-[14.75rem] left-[23%] hidden text-white/95 lg:block"
    >
      <span class="block rotate-[-18deg] text-[2rem]">✦</span>
    </div>
    <div
      class="pointer-events-none absolute top-[9.7rem] right-[22%] hidden text-white/95 lg:block"
    >
      <span class="block rotate-[18deg] text-[2rem]">✦</span>
    </div>

    <div
      class="relative mx-auto mt-10 max-w-[980px] sm:mt-12 lg:mt-16"
      data-testimonials-carousel
    >
      <div class="touch-pan-y overflow-hidden sm:px-14" data-embla-viewport>
        <div class="-ml-4 flex" data-embla-container>
          {
            testimonials.map((testimonial) => (
              <article
                class="min-w-0 shrink-0 grow-0 basis-full pl-4"
                aria-roledescription="slide"
              >
                <div class="relative overflow-hidden rounded-[1.55rem] border border-white/14 bg-[rgba(255,255,255,0.11)] p-4 shadow-[0_20px_40px_rgba(0,0,0,0.14)] backdrop-blur-md sm:rounded-[1.9rem] sm:p-6 lg:p-8">
                  <div class="pointer-events-none absolute top-0 right-0 text-[4.8rem] leading-none font-bold tracking-[-0.08em] text-[#667085]/55 sm:text-[7rem]">
                    ”
                  </div>

                  <div class="mb-5 flex items-start justify-between gap-4 pr-12 sm:mb-6 sm:gap-5">
                    <div class="flex items-center gap-3 sm:gap-4">
                      <div class="h-12 w-12 rounded-full bg-[radial-gradient(circle_at_35%_30%,#f8d1a1_0%,#8d664f_38%,#324b68_100%)] ring-2 ring-white/16 sm:h-14 sm:w-14">
                      </div>
                      <div>
                        <div class="text-[1.3rem] leading-none font-bold tracking-[-0.05em] text-white sm:text-[2rem]">
                          {testimonial.name}
                        </div>
                        <div class="mt-1 text-[0.9rem] text-white/70 sm:text-[1.05rem]">
                          {testimonial.role}
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="mb-4 flex items-center gap-1.5 text-[#f58a3a] sm:gap-2">
                    {
                      stars.map(() => (
                        <span class="text-[1.55rem] leading-none sm:text-[2rem]">
                          ★
                        </span>
                      ))
                    }
                    <span class="ml-1 text-[1.65rem] font-bold text-white sm:text-[2rem]">
                      {testimonial.rating.toFixed(1)}
                    </span>
                  </div>

                  <p class="max-w-[780px] text-[0.98rem] leading-[1.55] text-white/90 sm:text-[1.08rem] sm:leading-[1.5]">
                    {testimonial.quote}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <button
        type="button"
        class="absolute top-1/2 left-2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/14 bg-white/10 text-xl text-white backdrop-blur-md transition hover:bg-white/16 disabled:cursor-not-allowed disabled:opacity-35 sm:left-0 sm:h-11 sm:w-11"
        aria-label="Previous testimonial"
        data-embla-prev
      >
        ←
      </button>

      <button
        type="button"
        class="absolute top-1/2 right-2 z-20 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-white/14 bg-white/10 text-xl text-white backdrop-blur-md transition hover:bg-white/16 disabled:cursor-not-allowed disabled:opacity-35 sm:right-0 sm:h-11 sm:w-11"
        aria-label="Next testimonial"
        data-embla-next
      >
        →
      </button>

      <div class="mt-6 flex items-center justify-center gap-2.5" data-embla-dots>
        {
          testimonials.map((_, index) => (
            <button
              type="button"
              class:list={[
                "h-2.5 rounded-full transition-all duration-300",
                index === 0
                  ? "w-8 bg-[#f58a3a]"
                  : "w-2.5 bg-white/25 hover:bg-white/40",
              ]}
              aria-label={`Go to testimonial ${index + 1}`}
              aria-current={index === 0 ? "true" : "false"}
              data-embla-dot
            >
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel"

  const cleanupMap = new WeakMap<HTMLElement, () => void>()

  const initTestimonialsCarousel = () => {
    const carousels = document.querySelectorAll("[data-testimonials-carousel]")

    carousels.forEach((root) => {
      if (!(root instanceof HTMLElement)) {
        return
      }

      const existingCleanup = cleanupMap.get(root)
      if (typeof existingCleanup === "function") {
        existingCleanup()
      }

      const viewport = root.querySelector("[data-embla-viewport]")
      const prevButton = root.querySelector("[data-embla-prev]")
      const nextButton = root.querySelector("[data-embla-next]")
      const dotButtons = Array.from(root.querySelectorAll("[data-embla-dot]"))

      if (!(viewport instanceof HTMLElement)) {
        return
      }

      const embla = EmblaCarousel(viewport, {
        align: "start",
        loop: true,
      })
      let autoplayId = window.setInterval(() => embla.scrollNext(), 4500)
      const disposers: Array<() => void> = []

      const restartAutoplay = () => {
        window.clearInterval(autoplayId)
        autoplayId = window.setInterval(() => embla.scrollNext(), 4500)
      }

      const updateButtons = () => {
        if (prevButton instanceof HTMLButtonElement) {
          prevButton.disabled = !embla.canScrollPrev()
        }

        if (nextButton instanceof HTMLButtonElement) {
          nextButton.disabled = !embla.canScrollNext()
        }
      }

      const updateDots = () => {
        const selectedIndex = embla.selectedScrollSnap()

        dotButtons.forEach((dot, index) => {
          if (!(dot instanceof HTMLButtonElement)) {
            return
          }

          const isActive = index === selectedIndex
          dot.ariaCurrent = isActive ? "true" : "false"
          dot.classList.toggle("w-8", isActive)
          dot.classList.toggle("bg-[#f58a3a]", isActive)
          dot.classList.toggle("w-2.5", !isActive)
          dot.classList.toggle("bg-white/25", !isActive)
        })
      }

      if (prevButton instanceof HTMLButtonElement) {
        const onPrevClick = () => {
          embla.scrollPrev()
          restartAutoplay()
        }
        prevButton.addEventListener("click", onPrevClick)
        disposers.push(() => prevButton.removeEventListener("click", onPrevClick))
      }

      if (nextButton instanceof HTMLButtonElement) {
        const onNextClick = () => {
          embla.scrollNext()
          restartAutoplay()
        }
        nextButton.addEventListener("click", onNextClick)
        disposers.push(() => nextButton.removeEventListener("click", onNextClick))
      }

      dotButtons.forEach((dot, index) => {
        if (!(dot instanceof HTMLButtonElement)) {
          return
        }

        const onDotClick = () => {
          embla.scrollTo(index)
          restartAutoplay()
        }

        dot.addEventListener("click", onDotClick)
        disposers.push(() => dot.removeEventListener("click", onDotClick))
      })

      const onMouseEnter = () => window.clearInterval(autoplayId)
      const onMouseLeave = () => restartAutoplay()
      const onFocusIn = () => window.clearInterval(autoplayId)
      const onFocusOut = () => restartAutoplay()
      const onVisibilityChange = () => {
        if (document.hidden) {
          window.clearInterval(autoplayId)
          return
        }

        restartAutoplay()
      }

      root.addEventListener("mouseenter", onMouseEnter)
      root.addEventListener("mouseleave", onMouseLeave)
      root.addEventListener("focusin", onFocusIn)
      root.addEventListener("focusout", onFocusOut)
      document.addEventListener("visibilitychange", onVisibilityChange)

      disposers.push(() => root.removeEventListener("mouseenter", onMouseEnter))
      disposers.push(() => root.removeEventListener("mouseleave", onMouseLeave))
      disposers.push(() => root.removeEventListener("focusin", onFocusIn))
      disposers.push(() => root.removeEventListener("focusout", onFocusOut))
      disposers.push(() =>
        document.removeEventListener("visibilitychange", onVisibilityChange)
      )

      embla.on("init", updateButtons)
      embla.on("init", updateDots)
      embla.on("reInit", updateButtons)
      embla.on("reInit", updateDots)
      embla.on("select", updateButtons)
      embla.on("select", updateDots)
      embla.on("pointerDown", () => window.clearInterval(autoplayId))
      embla.on("settle", restartAutoplay)

      updateButtons()
      updateDots()

      root.dataset.emblaReady = "true"
      cleanupMap.set(root, () => {
        window.clearInterval(autoplayId)
        disposers.forEach((dispose) => dispose())
        embla.destroy()
        cleanupMap.delete(root)
        delete root.dataset.emblaReady
      })
    })
  }

  const bootTestimonialsCarousel = () => {
    window.requestAnimationFrame(initTestimonialsCarousel)
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootTestimonialsCarousel, {
      once: true,
    })
  } else {
    bootTestimonialsCarousel()
  }

  document.addEventListener("astro:page-load", bootTestimonialsCarousel)
</script>
