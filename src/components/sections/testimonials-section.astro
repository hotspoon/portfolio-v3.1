---
import textureBg from "@/assets/img/service-bg.png"

const stars = Array.from({ length: 5 })
---

<section
  class="relative overflow-hidden rounded-[3rem] px-4 py-12 text-white sm:px-6 lg:px-8"
  style={`background-image: url(${textureBg.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 bg-[#121212]/82"></div>
  <div
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.02)_0%,rgba(255,255,255,0)_100%)]"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-[1200px]">
    <div class="mx-auto max-w-[760px] text-center">
      <h2
        class="text-[3.35rem] leading-[1.08] font-black tracking-[-0.07em] text-white sm:text-[4rem]"
      >
        Testimonials That
        <span class="relative inline-block">
          <span class="absolute -top-4 -right-7 text-[2.1rem] text-white"
            >〴</span
          >
          <span class="absolute -top-6 -right-4 text-[1.5rem] text-white"
            >〳</span
          >
          <span class="absolute -top-4 -right-2 text-[1.15rem] text-white"
            >〵</span
          >
        </span>
        <br />
        Speak to <span class="text-[#f58a3a]">My Results</span>
      </h2>

      <p
        class="mx-auto mt-5 max-w-[760px] text-[1.05rem] leading-[1.45] text-white/78"
      >
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed congue
        interdum ligula a dignissim. Lorem ipsum dolor sit amet, consectetur
        adipiscing elit. Sed lobortis orci elementum egestas lobortis.
      </p>
    </div>

    <div
      class="pointer-events-none absolute top-[14.75rem] left-[23%] text-white/95"
    >
      <span class="block rotate-[-18deg] text-[2rem]">✦</span>
    </div>
    <div
      class="pointer-events-none absolute top-[9.7rem] right-[22%] text-white/95"
    >
      <span class="block rotate-[18deg] text-[2rem]">✦</span>
    </div>

    <div
      class="mt-16 grid grid-cols-[220px_minmax(0,1fr)_220px] items-center gap-5 overflow-hidden"
    >
      <article
        class="relative -translate-x-12 rounded-[1.9rem] border border-white/12 bg-[rgba(255,255,255,0.08)] p-5 opacity-90 backdrop-blur-md"
      >
        <div
          class="mb-5 text-right text-[7rem] leading-none font-bold tracking-[-0.08em] text-[#667085]/55"
        >
          ”
        </div>
        <p class="text-[0.92rem] leading-[1.45] text-white/86">
          ligula a dignissim. Lorem Sed lobortis orci elementum egestas
          lobortis.Sed lobortis orci
        </p>
      </article>

      <article
        class="relative rounded-[1.9rem] border border-white/14 bg-[rgba(255,255,255,0.11)] p-6 shadow-[0_20px_40px_rgba(0,0,0,0.14)] backdrop-blur-md"
      >
        <div class="mb-4 flex items-start justify-between gap-5">
          <div class="flex items-center gap-4">
            <div
              class="h-14 w-14 rounded-full bg-[radial-gradient(circle_at_35%_30%,#f8d1a1_0%,#8d664f_38%,#324b68_100%)] ring-2 ring-white/16"
            >
            </div>
            <div>
              <div
                class="text-[2rem] leading-none font-bold tracking-[-0.05em] text-white"
              >
                Jayesh Patil
              </div>
              <div class="mt-1 text-[1.05rem] text-white/70">CEO, Lirante</div>
            </div>
          </div>

          <div
            class="text-right text-[7rem] leading-none font-bold tracking-[-0.08em] text-[#667085]/55"
          >
            ”
          </div>
        </div>

        <div class="mb-4 flex items-center gap-2 text-[#f58a3a]">
          {stars.map(() => <span class="text-[2rem] leading-none">★</span>)}
          <span class="ml-1 text-[2rem] font-bold text-white">5.0</span>
        </div>

        <p class="max-w-[780px] text-[1.08rem] leading-[1.5] text-white/90">
          consectetur adipiscing elit. Sed congue interdum ligula a dignissim.
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed lobortis
          orci elementum egestas lobortis.Sed lobortis orci elementum egestas
          lobortis.Sed lobortis orci elementum egestas lobortis.
        </p>
      </article>

      <article
        class="relative translate-x-12 rounded-[1.9rem] border border-white/12 bg-[rgba(255,255,255,0.08)] p-5 opacity-90 backdrop-blur-md"
      >
        <div class="mb-4 flex items-center gap-3">
          <div
            class="h-12 w-12 rounded-full bg-[radial-gradient(circle_at_35%_30%,#f8d1a1_0%,#8d664f_38%,#324b68_100%)] ring-2 ring-white/16"
          >
          </div>
          <div>
            <div class="text-[1.1rem] leading-none font-bold text-white">
              Jayesh Patil
            </div>
            <div class="mt-1 text-sm text-white/70">CEO, Lirante</div>
          </div>
        </div>
        <div class="mb-4 flex items-center gap-1.5 text-[#f58a3a]">
          {stars.map(() => <span class="text-[1.55rem] leading-none">★</span>)}
          <span class="ml-1 text-[1.7rem] font-bold text-white">5.0</span>
        </div>
        <p class="text-[0.92rem] leading-[1.45] text-white/86">
          consectetur adipiscing elit. Sed ipsum dolor sit amet, consectetur
          egestas lobortis.
        </p>
      </article>
    </div>
  </div>
</section>
