---
import { Image } from "astro:assets"
import aurelisWeb from "@/assets/img/aurelis-web.png"
import rmSederhanaWeb from "@/assets/img/rm-sederhana-web.png"
import cepattagihHome from "@/assets/img/cepattagih/home.png"
import cepattagihInvoice from "@/assets/img/cepattagih/demo_invoice.png"
import sahutajaHome from "@/assets/img/sahutaja/landing_page_home.png"
import sahutajaDashboard from "@/assets/img/sahutaja/dashboard.png"

const caseStudies = [
  {
    company: "PT Bank Rakyat Indonesia Tbk",
    title: "NDS Payment Engine",
    image: "/placeholders/nds-payment-engine.svg",
    role: "Frontend Developer",
    period: "2025 - Present",
    challenge:
      "Built frontend flows for national-scale payment services where reliability and release quality mattered.",
    impact:
      "Implemented inquiry, validation, and transaction confirmation flows while reducing duplication through reusable UI and integration adapters.",
    stack: ["Vue", "Quasar", "Vuex", "gRPC", "REST API"],
    tone: "dark",
  },
  {
    company: "PT Bank Maybank Indonesia Tbk",
    title: "M2U ID Web Multicurrency",
    image: "/placeholders/m2u-multicurrency.svg",
    role: "Frontend Developer",
    period: "2025",
    challenge:
      "Delivered a multicurrency capability for a digital banking web app used by individual customers.",
    impact:
      "Helped extend core banking functionality in a customer-facing product using a modern React stack and predictable state management.",
    stack: ["React", "Redux", "Material UI"],
    tone: "light",
  },
  {
    company: "PT Telkom Indonesia",
    title: "Portal Klinik",
    image: "/placeholders/portal-klinik.svg",
    role: "Frontend Developer",
    period: "2024",
    challenge:
      "Built healthcare operations modules while improving quality, validation, and frontend performance.",
    impact:
      "Cut bugs by 80%, improved load time by 30%, and delivered a more reliable product through testing, validation, and performance optimization.",
    stack: ["Next.js", "React", "Redux", "SWR", "Zod", "Jest", "RTL"],
    tone: "orange",
  },
  {
    company: "PT GDC Multi Sarana",
    title: "GDCPay SSO Web Admin",
    image: "/placeholders/gdcpay-sso-admin.svg",
    role: "Frontend Developer / Fullstack Contributor",
    period: "2020 - 2024",
    challenge:
      "Worked on admin and payment products covering reconciliation, merchant operations, and internal business workflows.",
    impact:
      "Automated work equivalent to 50 hours per month, improved loading time by 15%, and supported secure backend services plus partner integrations.",
    stack: [
      "Next.js",
      "React",
      "TypeScript",
      "Flask",
      "Django",
      "Node.js",
      "MySQL",
    ],
    tone: "light",
  },
]

const landingPageProjects = [
  {
    title: "CepatTagih",
    image: cepattagihHome,
    secondaryImage: cepattagihInvoice,
    url: "https://invoiceflow-next.vercel.app/",
    type: "Invoice Management",
    summary:
      "A focused invoicing product that turns billing into a clearer, more confident workflow for growing businesses.",
    highlights: [
      "Invoice workspace",
      "Payment visibility",
      "Fast business flow",
    ],
    accent: "sunset",
    layout: "featured",
  },
  {
    title: "Sahutaja",
    image: sahutajaHome,
    secondaryImage: sahutajaDashboard,
    url: "https://sahutaja.vercel.app/",
    type: "Community Platform",
    summary:
      "A warm digital space for conversations, updates, and everyday community coordination in one approachable experience.",
    highlights: [
      "Conversation-first UX",
      "Activity dashboard",
      "Friendly visual system",
    ],
    accent: "ocean",
    layout: "featured",
  },
  {
    title: "Auralis",
    image: aurelisWeb,
    secondaryImage: aurelisWeb,
    url: "https://auralisapp.vercel.app/",
    type: "SaaS Landing Page",
    summary:
      "A product-focused landing page for a membership management platform serving associations, clubs, and community-led organisations.",
    highlights: [
      "Clear product storytelling",
      "Feature-driven section flow",
      "B2B SaaS positioning",
    ],
    accent: "ink",
    layout: "standard",
  },
  {
    title: "RM Sederhana",
    image: rmSederhanaWeb,
    secondaryImage: rmSederhanaWeb,
    url: "https://rm-sederhana.vercel.app/",
    type: "Restaurant Landing Page",
    summary:
      "A brand-led landing page concept built to present a restaurant experience with a stronger focus on atmosphere, menu discovery, and first impressions.",
    highlights: [
      "Hospitality-first layout",
      "Brand and menu presentation",
      "Mobile-friendly browsing flow",
    ],
    accent: "cream",
    layout: "standard",
  },
]

const proofPoints = [
  "Banking and payment domain experience",
  "Performance and testing as core priorities",
  "Reusable component and integration mindset",
  "Comfortable across frontend and backend collaboration",
]
---

<section id="project" class="bg-white px-4 py-12 sm:px-6 lg:px-8 xl:px-10">
  <div class="mx-auto max-w-[1180px]">
    <div
      data-nav-anchor="project"
      class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
    >
      <div class="max-w-[760px]">
        <p class="text-base font-semibold text-[#2f3b52]">
          Selected case studies
        </p>
        <h2
          class="mt-2 text-[2.2rem] leading-[0.98] font-black tracking-[-0.075em] text-[#2f3b52] sm:text-[3rem] lg:text-[3.6rem] xl:text-[4.3rem]"
          data-reveal
        >
          Work that shipped
          <span class="text-[#b35a1a]"> with impact</span>
        </h2>
        <p
          class="mt-4 max-w-[700px] text-sm leading-7 text-[#667085] sm:text-base sm:leading-8"
          data-reveal
        >
          These are not just mock projects. They represent real product work in
          banking, healthcare, and payment systems where reliability,
          performance, and business impact were part of the job.
        </p>
      </div>

      <a
        href="#contact"
        class="inline-flex min-h-[50px] min-w-[120px] items-center justify-center rounded-full bg-[#8f4714] px-5 text-base font-bold text-white transition hover:brightness-105 sm:mt-4 sm:min-h-[56px] sm:px-6 sm:text-lg"
        data-reveal="scale"
      >
        Let&apos;s Talk
      </a>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {
        caseStudies.map((item) => (
          <article
            class:list={[
              "hover-lift flex h-full flex-col rounded-[1.6rem] border p-5 shadow-[0_18px_42px_rgba(28,41,65,0.06)] sm:rounded-[1.9rem] sm:p-6 xl:p-7",
              item.tone === "dark" &&
                "border-[#243244] bg-[#243244] text-white",
              item.tone === "orange" &&
                "border-[#ffd8ba] bg-[linear-gradient(180deg,#fff8f2_0%,#fff2e8_100%)] text-[#243244]",
              item.tone === "light" &&
                "border-[#e7ecf3] bg-[linear-gradient(180deg,#fbfcfe_0%,#f6f8fb_100%)] text-[#243244]",
            ]}
            data-reveal
          >
            <div class="mb-5 overflow-hidden rounded-[1.3rem] border border-black/5 bg-white/40">
              {item.image.startsWith("/") ? (
                <Image
                  src={item.image}
                  alt={item.title}
                  width={828}
                  height={440}
                  class="h-[190px] w-full object-cover object-center sm:h-[220px]"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={item.image}
                  alt={item.title}
                  width={828}
                  height={440}
                  class="h-[190px] w-full object-cover object-center sm:h-[220px]"
                  widths={[480, 640, 828]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>

            <div class="flex flex-wrap items-center gap-3 text-sm">
              <span
                class:list={[
                  "rounded-full px-3 py-1 font-semibold",
                  item.tone === "dark"
                    ? "bg-white/10 text-[#f8c89d]"
                    : "bg-white text-[#c96b1d] shadow-[0_8px_18px_rgba(28,41,65,0.06)]",
                ]}
              >
                {item.role}
              </span>
              <span
                class:list={[
                  item.tone === "dark" ? "text-white/65" : "text-[#7b8799]",
                ]}
              >
                {item.company}
              </span>
              <span
                class:list={[
                  item.tone === "dark" ? "text-white/65" : "text-[#7b8799]",
                ]}
              >
                {item.period}
              </span>
            </div>

            <h3 class="mt-5 text-[1.5rem] leading-[1.08] font-black tracking-[-0.055em] sm:text-[2rem]">
              {item.title}
            </h3>

            <div class="mt-6 space-y-4">
              <div>
                <p
                  class:list={[
                    "text-xs font-semibold tracking-[0.08em] uppercase",
                    item.tone === "dark" ? "text-[#f8c89d]" : "text-[#b35a1a]",
                  ]}
                >
                  Scope
                </p>
                <p
                  class:list={[
                    "mt-2 text-sm leading-7 sm:text-base sm:leading-8",
                    item.tone === "dark" ? "text-white/78" : "text-[#667085]",
                  ]}
                >
                  {item.challenge}
                </p>
              </div>

              <div>
                <p
                  class:list={[
                    "text-xs font-semibold tracking-[0.08em] uppercase",
                    item.tone === "dark" ? "text-[#f8c89d]" : "text-[#b35a1a]",
                  ]}
                >
                  Impact
                </p>
                <p
                  class:list={[
                    "mt-2 text-sm leading-7 sm:text-base sm:leading-8",
                    item.tone === "dark" ? "text-white/88" : "text-[#475467]",
                  ]}
                >
                  {item.impact}
                </p>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-2.5">
              {item.stack.map((tag) => (
                <span
                  class:list={[
                    "rounded-full px-3 py-2 text-sm font-medium",
                    item.tone === "dark"
                      ? "bg-white/10 text-white"
                      : "bg-white text-[#475467] shadow-[0_8px_18px_rgba(28,41,65,0.05)]",
                  ]}
                >
                  {tag}
                </span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 sm:mt-12" data-reveal>
      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div class="max-w-[760px]">
          <p
            class="text-sm font-semibold tracking-[0.08em] text-[#b35a1a] uppercase"
          >
            Personal landing page work
          </p>
          <h3
            class="mt-2 text-[1.55rem] leading-[1.02] font-black tracking-[-0.055em] text-[#243244] sm:text-[2rem] lg:text-[2.45rem]"
          >
            Product pages
          </h3>
          <p
            class="mt-3 max-w-[720px] text-sm leading-7 text-[#667085] sm:text-base sm:leading-8"
          >
            Alongside product work in larger teams, I also build standalone
            landing pages that focus on sharp messaging, visual structure, and
            responsive presentation.
          </p>
        </div>
      </div>

      <div class="mt-7 grid gap-5 lg:grid-cols-2">
        {
          landingPageProjects.map((item) => (
            <article
              class:list={[
                "hover-lift group relative overflow-hidden rounded-[1.7rem] border shadow-[0_18px_42px_rgba(28,41,65,0.07)]",
                item.layout === "featured" && "lg:col-span-2",
                item.accent === "sunset" &&
                  "border-[#f3cfb3] bg-[linear-gradient(125deg,#fff7ee_0%,#fff0e2_48%,#ffe1c4_100%)] text-[#3d281d]",
                item.accent === "ocean" &&
                  "border-[#c8e4eb] bg-[linear-gradient(125deg,#effbfc_0%,#e1f4f8_50%,#d7edf5_100%)] text-[#183945]",
                item.accent === "ink" &&
                  "border-[#243244] bg-[#243244] text-white",
                item.accent === "cream" &&
                  "border-[#f0d9c8] bg-[linear-gradient(180deg,#fffaf5_0%,#fff0e4_100%)] text-[#243244]",
              ]}
              data-reveal
            >
              {item.layout === "featured" ? (
                <div class="grid lg:grid-cols-[1.02fr_0.98fr]">
                  <div class="relative min-h-[290px] overflow-hidden p-4 sm:p-5 lg:min-h-[390px] lg:p-6">
                    <div class="absolute inset-x-10 top-10 h-40 rounded-full bg-white/40 blur-3xl" />
                    <div class="relative h-full overflow-hidden rounded-[1.2rem] border border-white/70 bg-white/55 shadow-[0_18px_34px_rgba(40,60,72,0.13)]">
                      <Image
                        src={item.image}
                        alt={`${item.title} homepage`}
                        width={1024}
                        height={560}
                        class="h-[280px] w-full object-cover object-top transition duration-500 group-hover:scale-[1.025] sm:h-[350px] lg:h-[390px]"
                        widths={[480, 768, 1024]}
                        sizes="(min-width: 1024px) 50vw, 100vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="absolute right-7 bottom-3 hidden w-[42%] overflow-hidden rounded-xl border-4 border-white/80 bg-white shadow-[0_18px_34px_rgba(40,60,72,0.18)] sm:block lg:right-9 lg:bottom-6">
                      <Image
                        src={item.secondaryImage}
                        alt={`${item.title} product detail`}
                        width={560}
                        height={350}
                        class="aspect-[1.6] w-full object-cover object-top"
                        widths={[320, 560]}
                        sizes="(min-width: 1024px) 22vw, 38vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <div class="flex flex-col justify-center p-5 sm:p-7 lg:p-9">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="rounded-full bg-white/75 px-3 py-1 text-sm font-bold text-[#a34c16] shadow-[0_8px_18px_rgba(28,41,65,0.06)]">
                        {item.type}
                      </span>
                      <span class="text-xs font-semibold tracking-[0.12em] uppercase opacity-55">
                        Featured build
                      </span>
                    </div>
                    <h4 class="mt-6 text-[2rem] leading-[0.96] font-black tracking-[-0.065em] sm:text-[2.7rem]">
                      {item.title}
                    </h4>
                    <p class="mt-4 max-w-[470px] text-sm leading-7 opacity-75 sm:text-base sm:leading-8">
                      {item.summary}
                    </p>
                    <div class="mt-6 flex flex-wrap gap-2.5">
                      {item.highlights.map((point) => (
                        <span class="rounded-full border border-white/70 bg-white/60 px-3 py-2 text-sm font-medium shadow-[0_8px_18px_rgba(28,41,65,0.04)]">
                          {point}
                        </span>
                      ))}
                    </div>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noreferrer"
                      class="mt-7 inline-flex w-fit items-center gap-2 rounded-full bg-[#243244] px-5 py-3 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#b35a1a]"
                    >
                      Visit live site <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>
              ) : (
                <div>
                  <div class="border-b border-black/5 bg-white/30 p-4 sm:p-5">
                    <div class="overflow-hidden rounded-[1.2rem] border border-black/5 bg-white/60">
                      <Image
                        src={item.image}
                        alt={item.title}
                        width={1024}
                        height={560}
                        class="h-[220px] w-full object-cover object-center transition duration-500 group-hover:scale-[1.025] sm:h-[250px]"
                        widths={[480, 768, 1024]}
                        sizes="(min-width: 1024px) 50vw, 100vw"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  </div>
                  <div class="p-5 sm:p-6">
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="rounded-full bg-white/80 px-3 py-1 text-sm font-semibold text-[#b35a1a] shadow-[0_8px_18px_rgba(28,41,65,0.05)]">
                        {item.type}
                      </span>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center rounded-full border border-black/8 bg-white/80 px-3 py-1 text-sm font-medium text-[#475467] transition hover:border-[#b35a1a]/30 hover:text-[#243244]"
                      >
                        Live Site
                      </a>
                    </div>

                    <h4 class="mt-5 text-[1.55rem] leading-[1.06] font-black tracking-[-0.05em]">
                      {item.title}
                    </h4>
                    <p
                      class:list={[
                        "mt-3 text-sm leading-7 sm:text-base sm:leading-8",
                        item.accent === "ink"
                          ? "text-white/80"
                          : "text-[#667085]",
                      ]}
                    >
                      {item.summary}
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2.5">
                      {item.highlights.map((point) => (
                        <span class="rounded-full bg-white px-3 py-2 text-sm font-medium text-[#475467] shadow-[0_8px_18px_rgba(28,41,65,0.05)]">
                          {point}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <div
      class="mt-10 rounded-[1.8rem] border border-[#e7ecf3] bg-[#f8fafc] p-5 shadow-[0_18px_42px_rgba(28,41,65,0.04)] sm:p-6 xl:p-7"
      data-reveal
    >
      <div
        class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between"
      >
        <div>
          <p
            class="text-sm font-semibold tracking-[0.08em] text-[#b35a1a] uppercase"
          >
            Why This Matters
          </p>
          <h3
            class="mt-2 text-[1.45rem] leading-tight font-black tracking-[-0.05em] text-[#243244] sm:text-[1.9rem]"
          >
            The profile behind the projects
          </h3>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          proofPoints.map((point) => (
            <span
              class="rounded-full bg-white px-4 py-3 text-sm font-medium text-[#475467] shadow-[0_10px_22px_rgba(35,43,59,0.04)]"
              data-reveal="scale"
            >
              {point}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>
