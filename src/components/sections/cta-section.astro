---
const badges = [
  "React, Vue & Next.js",
  "Jest & React Testing Library",
  "gRPC & REST API",
]

const marqueeItems = [
  "Frontend Development",
  "Financial Systems",
  "Testing",
  "Performance",
  "Reusable Components",
]
---

<section class="overflow-hidden bg-white px-4 pt-10 pb-0 sm:px-6 lg:px-8 xl:px-10">
  <div class="mx-auto max-w-[1280px]">
    <div class="text-center">
      <h2
        class="text-[2.2rem] leading-[1.08] font-black tracking-[-0.08em] text-[#33415c] sm:text-[3rem] lg:text-[3.9rem] xl:text-[4.9rem]"
        data-reveal
      >
        Need a frontend developer
        <br />
        for your product? <span class="text-[#ff8937]">Let&apos;s Talk</span>
      </h2>
    </div>

    <div class="mx-auto mt-8 max-w-[820px]">
      <div
        class="flex flex-col gap-4 rounded-[1.4rem] border border-[#e4e9f0] bg-white px-4 py-3 shadow-[0_12px_30px_rgba(26,32,44,0.04)] sm:flex-row sm:items-center sm:justify-between sm:rounded-[1.8rem] lg:rounded-full"
        data-reveal="scale"
      >
        <div class="flex items-center gap-3 px-1 sm:gap-4 sm:px-2">
          <div
            class="flex h-[3.3rem] w-[3.3rem] items-center justify-center rounded-full bg-[#ffe9d6] sm:h-[4.1rem] sm:w-[4.1rem]"
          >
            <div
              class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#ff8a37] text-base text-white sm:h-10 sm:w-10 sm:rounded-2xl sm:text-[1.35rem]"
            >
              ✉
            </div>
          </div>
          <div
            class="break-all text-[1rem] font-medium tracking-[-0.04em] text-[#161616] sm:break-normal sm:text-[1.2rem] lg:text-[1.7rem]"
          >
            fariez8@gmail.com
          </div>
        </div>

        <a
          href="mailto:fariez8@gmail.com"
          class="inline-flex min-h-[3.9rem] min-w-[8rem] items-center justify-center rounded-full bg-[#ff8937] px-6 text-[1.3rem] font-medium text-white transition hover:brightness-105 sm:min-h-[5rem] sm:min-w-[9rem] sm:px-8 sm:text-[1.7rem]"
        >
          Email Me
        </a>
      </div>

      <div
        class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-x-10"
      >
        {
          badges.map((badge) => (
            <div class="flex items-center gap-2 text-sm font-medium text-[#1c1f26] sm:text-[1.05rem]" data-reveal="scale">
              <span class="text-[1.15rem]">✦</span>
              <span>{badge}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="relative mt-12 h-[90px] overflow-hidden rounded-t-[1.2rem] bg-[#ff640f] sm:mt-14 sm:h-[120px] sm:rounded-t-[1.6rem] xl:h-[140px] xl:rounded-t-[2rem]"
    >
      <div
        class="absolute inset-x-[-2rem] top-[1.2rem] -rotate-[3.2deg] bg-white py-3 shadow-[0_10px_30px_rgba(0,0,0,0.08)] sm:top-[1.8rem] sm:py-4 xl:top-[2.25rem]"
      >
        <div
          class="marquee-track-slow flex min-w-max items-center justify-center gap-4 px-6 text-[1rem] leading-none font-medium tracking-[-0.05em] whitespace-nowrap text-black sm:gap-5 sm:px-8 sm:text-[1.45rem] xl:gap-6 xl:text-[2.1rem]"
        >
          {marqueeItems.map((item) => <span>{item}</span>)}
          <span class="text-[#ff8937]">✦</span>
          {marqueeItems.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
