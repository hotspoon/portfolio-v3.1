---
const badges = [
  "4.9/5 Average Ratings",
  "25+ Winning Awards",
  "Certified Product Designer",
]

const marqueeItems = [
  "UX Design",
  "App Design",
  "Dashboard",
  "Wireframe",
  "User Research",
]
---

<section class="overflow-hidden bg-white px-4 pt-10 pb-0 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-[1280px]">
    <div class="text-center">
      <h2
        class="text-[3.7rem] leading-[1.08] font-black tracking-[-0.08em] text-[#33415c] sm:text-[4.9rem]"
      >
        Have an Awsome Project
        <br />
        Idea? <span class="text-[#ff8937]">Let&apos;s Discuss</span>
      </h2>
    </div>

    <div class="mx-auto mt-8 max-w-[820px]">
      <div
        class="flex flex-col gap-4 rounded-full border border-[#e4e9f0] bg-white px-4 py-3 shadow-[0_12px_30px_rgba(26,32,44,0.04)] sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="flex items-center gap-4 px-2">
          <div
            class="flex h-[4.1rem] w-[4.1rem] items-center justify-center rounded-full bg-[#ffe9d6]"
          >
            <div
              class="flex h-10 w-10 items-center justify-center rounded-2xl bg-[#ff8a37] text-[1.35rem] text-white"
            >
              ✉
            </div>
          </div>
          <div
            class="text-[1.7rem] font-medium tracking-[-0.04em] text-[#161616]"
          >
            Enter Email Address
          </div>
        </div>

        <a
          href="mailto:hello@placeholder.com"
          class="inline-flex min-h-[5rem] min-w-[9rem] items-center justify-center rounded-full bg-[#ff8937] px-8 text-[1.7rem] font-medium text-white transition hover:brightness-105"
        >
          Send
        </a>
      </div>

      <div
        class="mt-4 flex flex-wrap items-center justify-center gap-x-10 gap-y-3"
      >
        {
          badges.map((badge) => (
            <div class="flex items-center gap-2 text-[1.05rem] font-medium text-[#1c1f26]">
              <span class="text-[1.15rem]">✦</span>
              <span>{badge}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="relative mt-14 h-[140px] overflow-hidden rounded-t-[2rem] bg-[#ff640f]"
    >
      <div
        class="absolute inset-x-[-2rem] top-[2.25rem] -rotate-[3.2deg] bg-white py-4 shadow-[0_10px_30px_rgba(0,0,0,0.08)]"
      >
        <div
          class="flex min-w-max items-center justify-center gap-6 px-8 text-[2.1rem] leading-none font-medium tracking-[-0.05em] whitespace-nowrap text-black"
        >
          {marqueeItems.map((item) => <span>{item}</span>)}
          <span class="text-[#ff8937]">✦</span>
          {marqueeItems.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
