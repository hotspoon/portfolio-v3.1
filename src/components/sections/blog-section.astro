---
import blogImage1 from "@/assets/img/blog-1.png"
import blogImage2 from "@/assets/img/blog-2.png"
import blogImage3 from "@/assets/img/blog-3.png"

const blogCards = [
  {
    image: blogImage1,
    category: "UI/ UX Design",
    author: "Jayesh Patil",
    date: "10 Nov, 2023",
    title: "Design Unraveled: Behind the Scenes of UI/UX Magic",
    frame: "border-[#7d4dff]",
  },
  {
    image: blogImage2,
    category: "App Design",
    author: "Jayesh Patil",
    date: "09 Oct, 2023",
    title: "Sugee: Loan Management System for Rural Sector.",
    frame: "border-transparent",
  },
  {
    image: blogImage3,
    category: "App Design",
    author: "Jayesh Patil",
    date: "13 Aug, 2023",
    title: "Cinetrade: Innovative way to invest in Digital Media",
    frame: "border-transparent",
  },
]
---

<section class="bg-white px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-[1240px]">
    <div class="mb-10 flex items-start justify-between gap-6">
      <div>
        <h2
          class="text-[3.55rem] leading-[0.95] font-black tracking-[-0.075em] text-[#2f3b52] sm:text-[4.2rem]"
        >
          From my
          <br />
          blog post
        </h2>
      </div>

      <a
        href="#contact"
        class="mt-4 inline-flex min-h-[54px] min-w-[110px] items-center justify-center rounded-full bg-[#f58a3a] px-6 text-lg font-bold text-white transition hover:brightness-105"
      >
        See All
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {
        blogCards.map((card) => (
          <article>
            <div class="relative">
              <div
                class:list={[
                  "overflow-hidden rounded-[2rem] border-[3px] bg-white",
                  card.frame,
                ]}
              >
                <img
                  src={card.image.src}
                  alt={card.title}
                  class="h-[360px] w-full object-cover object-center"
                />
              </div>

              <div class="absolute right-[-2px] bottom-[-12px] flex h-[5.7rem] w-[5.7rem] items-center justify-center rounded-full bg-[#1c2941] text-[2.6rem] text-white shadow-[0_16px_26px_rgba(13,21,39,0.32)]">
                ↗
              </div>
            </div>

            <div class="mt-8">
              <span class="inline-flex rounded-full bg-[#f1f4f8] px-7 py-3 text-[1.02rem] font-medium text-[#3d475a]">
                {card.category}
              </span>

              <div class="mt-8 flex flex-wrap items-center gap-4 text-[1.05rem] text-[#6d7890]">
                <span class="inline-flex items-center gap-2">
                  <span class="text-[#f58a3a]">•</span>
                  <span>{card.author}</span>
                </span>
                <span class="inline-flex items-center gap-2">
                  <span class="text-[#f58a3a]">•</span>
                  <span>{card.date}</span>
                </span>
              </div>

              <h3 class="mt-6 text-[2.15rem] leading-[1.18] font-medium tracking-[-0.05em] text-[#3a4459]">
                {card.title}
              </h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
