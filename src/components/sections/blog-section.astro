---
import blogImage1 from "@/assets/img/blog-1.png"
import blogImage2 from "@/assets/img/blog-2.png"
import blogImage3 from "@/assets/img/blog-3.png"

const blogCards = [
  {
    image: blogImage1,
    category: "Certification",
    author: "Udemy",
    date: "April 2024",
    title: "The Ultimate React Course",
    href: "https://www.udemy.com/course/the-ultimate-react-course",
    frame: "border-[#7d4dff]",
  },
  {
    image: blogImage2,
    category: "Certification",
    author: "Udemy",
    date: "April 2024",
    title: "The Complete JavaScript Course",
    href: "https://www.udemy.com/course/the-complete-javascript-course",
    frame: "border-transparent",
  },
  {
    image: blogImage3,
    category: "Education",
    author: "Politeknik Elektronika Negeri Surabaya",
    date: "August 2016 - September 2020",
    title: "Bachelor of Applied Science in Informatics Engineering, GPA 3.06/4.0",
    href: "https://www.hamzahalfarisi.com/about/",
    frame: "border-transparent",
  },
]
---

<section class="bg-white px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-[1240px]">
    <div
      class="mb-8 flex flex-col gap-5 sm:mb-10 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
    >
      <div>
        <h2
          class="text-[2.75rem] leading-[0.95] font-black tracking-[-0.075em] text-[#2f3b52] sm:text-[4.2rem]"
        >
          Learning &
          <br />
          education
        </h2>
      </div>

      <a
        href="https://www.hamzahalfarisi.com/about/"
        target="_blank"
        rel="noreferrer"
        class="inline-flex min-h-[50px] min-w-[100px] items-center justify-center rounded-full bg-[#f58a3a] px-5 text-base font-bold text-white transition hover:brightness-105 sm:mt-4 sm:min-h-[54px] sm:min-w-[110px] sm:px-6 sm:text-lg"
      >
        View More
      </a>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      {
        blogCards.map((card) => (
          <article>
            <div class="relative">
              <a
                href={card.href}
                target="_blank"
                rel="noreferrer"
                class:list={[
                  "overflow-hidden rounded-[2rem] border-[3px] bg-white",
                  card.frame,
                ]}
              >
                <img
                  src={card.image.src}
                  alt={card.title}
                  class="h-[280px] w-full object-cover object-center sm:h-[360px]"
                />
              </a>

              <div class="absolute right-0 bottom-[-8px] flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-full bg-[#1c2941] text-[2rem] text-white shadow-[0_16px_26px_rgba(13,21,39,0.32)] sm:right-[-2px] sm:bottom-[-12px] sm:h-[5.7rem] sm:w-[5.7rem] sm:text-[2.6rem]">
                ↗
              </div>
            </div>

            <div class="mt-6 sm:mt-8">
              <span class="inline-flex rounded-full bg-[#f1f4f8] px-5 py-2.5 text-sm font-medium text-[#3d475a] sm:px-7 sm:py-3 sm:text-[1.02rem]">
                {card.category}
              </span>

              <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-[#6d7890] sm:mt-8 sm:text-[1.05rem]">
                <span class="inline-flex items-center gap-2">
                  <span class="text-[#f58a3a]">•</span>
                  <span>{card.author}</span>
                </span>
                <span class="inline-flex items-center gap-2">
                  <span class="text-[#f58a3a]">•</span>
                  <span>{card.date}</span>
                </span>
              </div>

              <h3 class="mt-5 text-[1.8rem] leading-[1.18] font-medium tracking-[-0.05em] text-[#3a4459] sm:mt-6 sm:text-[2.15rem]">
                {card.title}
              </h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
