---
import logo from "@/assets/img/jcrea-nav-logo.png"

const navigation = ["Home", "About Us", "Service", "Resume", "Project"]

const contactItems = [
  "+91 7738443636",
  "Jaycrea36@gmail.com",
  "Portfolio-jcrea.com",
]

const socials = ["f", "▶", "◔", "◉", "𝕏"]
---

<footer
  id="contact"
  class="rounded-t-[1.7rem] bg-[#2c2b2b] px-4 py-10 text-white sm:rounded-t-[2.4rem] sm:px-6 sm:py-12 lg:px-8"
>
  <div class="mx-auto max-w-[1300px]">
    <div
      class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between"
    >
      <h2
        class="text-[2.7rem] leading-none font-black tracking-[-0.075em] text-white sm:text-[4.6rem]"
      >
        Lets Connect there
      </h2>

      <a
        href="#contact"
        class="inline-flex min-h-[58px] min-w-[160px] items-center justify-center rounded-full bg-[#ff8937] px-6 text-[1.4rem] font-medium tracking-[-0.04em] text-white transition hover:brightness-105 sm:min-h-[74px] sm:min-w-[200px] sm:px-8 sm:text-[2rem]"
      >
        Hire me ↗
      </a>
    </div>

    <div class="mt-12 h-px w-full bg-[#58627a]"></div>

    <div
      class="grid gap-10 py-10 sm:py-12 lg:grid-cols-[1.35fr_0.55fr_0.75fr_0.95fr]"
    >
      <div>
        <div class="flex items-center gap-4">
          <img
            src={logo.src}
            alt="JCREA logo"
            class="h-14 w-14 object-contain"
          />
          <span
            class="text-[1.8rem] font-black tracking-[-0.04em] text-white sm:text-[2.2rem]"
          >
            JCREA
          </span>
        </div>

        <p
          class="mt-8 max-w-[620px] text-sm leading-[1.55] text-white/90 sm:mt-10 sm:text-[1rem]"
        >
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed congue
          interdum ligula a dignissim. Lorem ipsum dolor sit amet, consectetur
          adipiscing elit. Sed lobortis orci elementum egestas lobortis.
        </p>

        <div class="mt-6 flex items-center gap-3 sm:mt-8">
          {
            socials.map((item) => (
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm font-bold text-[#2c2b2b] sm:h-9 sm:w-9 sm:text-[1rem]">
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <div>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#ff8937] sm:text-[2rem]"
        >
          Navigation
        </h3>
        <div class="mt-5 space-y-4 sm:mt-8 sm:space-y-5">
          {
            navigation.map((item) => (
              <div class="text-base text-white sm:text-[1.2rem]">{item}</div>
            ))
          }
        </div>
      </div>

      <div>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#ff8937] sm:text-[2rem]"
        >
          Contact
        </h3>
        <div class="mt-5 space-y-4 sm:mt-8 sm:space-y-5">
          {
            contactItems.map((item) => (
              <div class="text-base text-white sm:text-[1.2rem]">{item}</div>
            ))
          }
        </div>
      </div>

      <div>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#ff8937] sm:text-[2rem]"
        >
          Get the latest information
        </h3>

        <div
          class="mt-6 overflow-hidden rounded-[1rem] bg-white sm:mt-10 sm:rounded-[1.2rem]"
        >
          <div class="grid grid-cols-[1fr_64px] items-stretch">
            <div
              class="px-4 py-4 text-base text-[#161616] sm:px-6 sm:py-5 sm:text-[1.2rem]"
            >
              Email Address
            </div>
            <button
              type="button"
              class="flex items-center justify-center bg-[#ff8937] text-[1.4rem] text-white sm:text-[1.8rem]"
            >
              ➤
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="h-px w-full bg-[#58627a]"></div>

    <div
      class="mt-8 flex flex-col gap-3 text-sm text-white/95 sm:mt-10 sm:text-[1rem] lg:flex-row lg:items-center lg:justify-between"
    >
      <p>Copyright© 2023 Jayesh. All Rights Reserved.</p>
      <p>User Terms & Conditions | Privacy Policy</p>
    </div>
  </div>
</footer>
