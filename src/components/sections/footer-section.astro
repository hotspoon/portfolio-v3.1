---
import { Image } from "astro:assets"
import logo from "@/assets/img/jcrea-nav-logo-v2.png"

const navigation = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "About" },
  { href: "#service", label: "Focus" },
  { href: "#resume", label: "Experience" },
  { href: "#project", label: "Projects" },
]

const contactItems = [
  "+62 81252373658",
  "fariez8@gmail.com",
  "linkedin.com/in/hamzah-al-farisi",
  "Jakarta, Indonesia",
  "hamzahalfarisi.com",
]

const socials = [
  {
    label: "GitHub",
    href: "https://github.com/hotspoon",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/hamzah-al-farisi",
  },
  {
    label: "Website",
    href: "https://www.hamzahalfarisi.com/",
  },
]
---

<footer
  id="contact"
  class="rounded-t-[1.5rem] bg-[#2c2b2b] px-4 py-10 text-white sm:rounded-t-[2rem] sm:px-6 sm:py-12 lg:px-8 xl:rounded-t-[2.4rem] xl:px-10"
>
  <div class="mx-auto max-w-[1300px]">
    <div
      class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between"
    >
      <h2
        class="max-w-[11ch] text-[2.2rem] leading-[0.98] font-black tracking-[-0.075em] text-white sm:text-[3rem] lg:text-[3.8rem] xl:max-w-none xl:text-[4.6rem]"
        data-reveal
      >
        Let&apos;s build something useful
      </h2>

      <a
        href="mailto:fariez8@gmail.com"
        class="inline-flex min-h-[58px] min-w-[160px] items-center justify-center rounded-full bg-[#b85f1d] px-6 text-[1.4rem] font-medium tracking-[-0.04em] text-white transition hover:brightness-105 sm:min-h-[74px] sm:min-w-[200px] sm:px-8 sm:text-[2rem]"
        data-reveal="scale"
      >
        Email me ↗
      </a>
    </div>

    <div class="mt-12 h-px w-full bg-[#58627a]"></div>

    <div
      class="grid gap-10 py-10 sm:py-12 md:grid-cols-2 xl:grid-cols-[1.35fr_0.55fr_0.75fr_0.95fr]"
    >
      <div data-reveal>
        <div class="flex items-center gap-4">
          <Image
            src={logo}
            alt="Hamzah logo"
            class="h-14 w-14 object-contain"
            width={56}
            sizes="56px"
            loading="lazy"
            decoding="async"
          />
          <span
            class="text-[1.8rem] font-black tracking-[-0.04em] text-white sm:text-[2.2rem]"
          >
              HAMZAH
          </span>
        </div>

        <p
          class="mt-8 max-w-[620px] text-sm leading-[1.55] text-white/90 sm:mt-10 sm:text-[1rem]"
        >
          Frontend Developer based in Jakarta, Indonesia. I build reliable web
          products for banking, payments, and internal business systems with a
          strong focus on performance, testing, and maintainable UI
          architecture.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3 sm:mt-8">
          {
            socials.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noreferrer"
                class="inline-flex rounded-full bg-white px-3 py-2 text-sm font-bold text-[#2c2b2b] transition hover:bg-[#b85f1d] hover:text-white sm:text-[1rem]"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div data-reveal>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#f2b67d] sm:text-[2rem]"
        >
          Navigation
        </h3>
        <div class="mt-5 space-y-4 sm:mt-8 sm:space-y-5">
          {
            navigation.map((item) => (
              <a href={item.href} class="block text-base text-white sm:text-[1.1rem] xl:text-[1.2rem]">
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div data-reveal>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#f2b67d] sm:text-[2rem]"
        >
          Contact
        </h3>
        <div class="mt-5 space-y-4 sm:mt-8 sm:space-y-5">
          {
            contactItems.map((item) => (
              <div class="break-words text-base text-white sm:text-[1.1rem] xl:text-[1.2rem]">{item}</div>
            ))
          }
        </div>
      </div>

      <div data-reveal>
        <h3
          class="text-[1.55rem] font-bold tracking-[-0.04em] text-[#f2b67d] sm:text-[2rem]"
        >
          Ready to collaborate?
        </h3>

        <div
          class="mt-6 overflow-hidden rounded-[1rem] bg-white sm:mt-10 sm:rounded-[1.2rem]"
        >
          <div class="grid grid-cols-[1fr_58px] items-stretch sm:grid-cols-[1fr_64px]">
            <div
              class="px-4 py-4 text-base text-[#161616] sm:px-6 sm:py-5 sm:text-[1.2rem]"
            >
              Start a conversation
            </div>
            <a
              href="mailto:fariez8@gmail.com"
              class="flex items-center justify-center bg-[#b85f1d] text-[1.4rem] text-white sm:text-[1.8rem]"
            >
              ➤
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="h-px w-full bg-[#58627a]"></div>

    <div
      class="mt-8 flex flex-col gap-3 text-sm text-white/95 sm:mt-10 sm:text-[1rem] lg:flex-row lg:items-center lg:justify-between"
    >
      <p>Copyright © 2026 Hamzah Al Farisi. All rights reserved.</p>
      <p>Frontend engineering for products that need reliability, scale, and clarity.</p>
    </div>
  </div>
</footer>
