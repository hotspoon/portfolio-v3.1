---
import Navbar from "@/components/navbar.astro"
import heroImage from "@/assets/img/young-pretty-woman-looking-happy-goofy-with-broad-fun-loony-smile-eyes-wide-open-against-white-wall 2.png"
import heroEllipse from "@/assets/img/Ellipse-2.png"
import helloSpark from "@/assets/img/Vector-1.png"
import accentStroke from "@/assets/img/Vector-2.png"

const stars = Array.from({ length: 5 })
---

<div class="px-4 pt-4 sm:px-6 lg:px-8">
  <Navbar />

  <section class="relative overflow-hidden px-2 pt-8 pb-0 sm:px-4 lg:px-8">
    <div class="relative z-20 mx-auto max-w-[820px] text-center">
      <div
        class="relative z-20 inline-flex items-center gap-3 rounded-full border border-[#1d1d1d]/35 bg-white px-5 py-2 text-lg font-semibold text-[#1d1d1d] shadow-[0_8px_18px_rgba(0,0,0,0.05)]"
      >
        <span>Hello!</span>
        <img src={helloSpark.src} alt="" class="h-5 w-auto" />
      </div>

      <h1
        class="mt-4 text-5xl leading-[0.9] font-black tracking-[-0.07em] text-[#141414] sm:text-6xl lg:text-[5.15rem]"
      >
        I'm <span class="text-[#f39a52]">Jenny,</span><br />
        Product Designer
      </h1>
    </div>

    <div
      class="relative mt-3 grid gap-4 lg:grid-cols-[1fr_minmax(640px,780px)_1fr] lg:items-center"
    >
      <aside class="flex justify-center lg:justify-start">
        <div class="max-w-[220px] text-center lg:mt-8 lg:text-left">
          <div class="mb-4 text-5xl leading-none font-black text-[#4b5563]">
            “
          </div>
          <p class="text-[15px] leading-[1.5] font-semibold text-[#475569]">
            Jenny's Exceptional product design ensure our website's success.
            Highly Recommended
          </p>
        </div>
      </aside>

      <div
        class="relative mx-auto flex min-h-[500px] w-full max-w-[760px] items-end justify-center overflow-visible lg:min-h-[520px]"
      >
        <img
          src={accentStroke.src}
          alt=""
          class="absolute top-[7.5rem] left-[3%] hidden w-16 -translate-x-1/3 lg:block"
        />
        <img
          src={heroEllipse.src}
          alt=""
          class="absolute bottom-0 z-0 w-[102%] max-w-[680px]"
        />
        <img
          src={heroImage.src}
          alt="Portrait illustration"
          class="absolute bottom-[1rem] left-1/2 z-30 w-[126%] max-w-[760px] -translate-x-1/2 object-contain drop-shadow-[0_18px_30px_rgba(77,43,12,0.18)] lg:bottom-[0rem] lg:w-[132%] lg:max-w-[820px]"
        />

        <div
          class="absolute bottom-3 z-40 w-[min(92%,290px)] rounded-[1.75rem] border border-white/35 bg-[rgba(119,86,58,0.23)] p-3 shadow-[0_18px_36px_rgba(88,56,31,0.18)] backdrop-blur-md"
        >
          <div class="grid grid-cols-[1.1fr_0.9fr] items-center gap-3">
            <a
              href="#project"
              class="rounded-full bg-[#f39a52] px-6 py-4 text-center text-xl font-bold whitespace-nowrap text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.25)] transition hover:brightness-105"
            >
              Portfolio ↗
            </a>
            <a
              href="#contact"
              class="text-center text-xl font-medium text-white/88 transition hover:text-white"
            >
              Hire me
            </a>
          </div>
        </div>
      </div>

      <aside class="flex justify-center lg:justify-end">
        <div class="text-center lg:mt-8 lg:text-right">
          <div
            class="mb-4 flex justify-center gap-1 text-[#f39a52] lg:justify-end"
          >
            {stars.map(() => <span class="text-[1.6rem] leading-none">★</span>)}
          </div>
          <div
            class="text-[3.2rem] leading-none font-black tracking-[-0.05em] text-[#161616]"
          >
            10 Years
          </div>
          <p class="mt-1 text-[1.45rem] font-medium text-[#3a3a3a]">
            Experince
          </p>
        </div>
      </aside>
    </div>
  </section>
</div>
