---
import { Image } from "astro:assets"
import Navbar from "@/components/navbar.astro"
import heroImage from "@/assets/img/my-image.png"
import heroEllipse from "@/assets/img/Ellipse-2.png"
import helloSpark from "@/assets/img/Vector-1.png"
import accentStroke from "@/assets/img/Vector-2.png"

const stars = Array.from({ length: 5 })
---

<div class="px-3 pt-3 sm:px-4 sm:pt-4 md:px-6 lg:px-8 xl:px-10">
  <Navbar />

  <section
    class="relative overflow-hidden px-0 pt-6 pb-0 sm:px-2 sm:pt-8 md:px-4 lg:px-6 xl:px-8"
  >
    <div class="relative z-20 mx-auto max-w-[980px] text-center">
      <div
        class="float-gentle relative z-20 inline-flex items-center gap-2 rounded-full border border-[#1d1d1d]/35 bg-white px-4 py-2 text-sm font-semibold text-[#1d1d1d] shadow-[0_8px_18px_rgba(0,0,0,0.05)] sm:gap-3 sm:px-5 md:text-base xl:text-lg"
        data-reveal="scale"
      >
        <span>Available for impactful work</span>
        <img src={helloSpark.src} alt="" class="h-4 w-auto sm:h-5" />
      </div>

      <h1
        class="mt-4 text-[2.55rem] leading-[0.95] font-black tracking-[-0.075em] text-[#141414] sm:text-[3.35rem] md:text-[4.15rem] lg:text-[4.9rem] xl:text-[5.45rem] 2xl:text-[6.1rem]"
        data-reveal
      >
        I'm <span class="text-[#f39a52]">Hamzah</span><br />
        Front-End Developer
      </h1>
      <p
        class="mx-auto mt-5 max-w-[760px] text-sm leading-7 font-medium text-[#5f6b7d] sm:text-base sm:leading-8 lg:text-[1.05rem]"
        data-reveal
      >
        I build reliable frontend products for banking, payments, and internal
        business systems with strong attention to performance, testing, and
        maintainable UI architecture.
      </p>
    </div>

    <div
      class="relative mt-5 grid gap-6 md:-mt-10 md:gap-8 xl:-mt-16 xl:grid-cols-[minmax(220px,1fr)_minmax(560px,820px)_minmax(220px,1fr)] xl:items-center"
    >
      <aside class="order-2 flex justify-center xl:order-none xl:justify-start">
        <div class="max-w-[320px] text-center xl:mt-8 xl:text-left" data-reveal>
          <div
            class="mb-3 text-4xl leading-none font-black text-[#4b5563] sm:text-5xl"
          >
            “
          </div>
          <p
            class="text-sm leading-[1.55] font-semibold text-[#475569] sm:text-[15px] xl:text-base"
          >
            Experienced in building high-scale transaction flows, reusable UI
            systems, and frontend architecture that teams can ship on with
            confidence.
          </p>
        </div>
      </aside>

      <div
        class="relative order-1 mx-auto flex min-h-[360px] w-full max-w-[860px] items-end justify-center overflow-visible sm:min-h-[460px] md:min-h-[620px] lg:min-h-[700px] xl:order-none xl:min-h-[760px]"
      >
        <img
          src={accentStroke.src}
          alt=""
          class="float-slow absolute top-[6.5rem] left-[32%] hidden w-14 -translate-x-1/3 xl:block 2xl:w-16"
        />
        <img
          src={heroEllipse.src}
          alt=""
          class="absolute bottom-0 z-0 w-[128%] max-w-[340px] sm:max-w-[460px] md:max-w-[580px] lg:max-w-[650px] xl:max-w-[720px]"
          data-reveal="scale"
        />
        <Image
          src={heroImage}
          alt="Portrait illustration"
          class="absolute bottom-0 left-1/2 z-30 w-[74%] max-w-[520px] -translate-x-1/2 object-contain drop-shadow-[0_18px_30px_rgba(77,43,12,0.18)] md:-bottom-24 lg:-bottom-16 sm:w-[70%] xl:w-[68%]"
          data-reveal="scale"
          width={520}
          sizes="(min-width: 1280px) 520px, (min-width: 1024px) 470px, (min-width: 768px) 420px, 74vw"
          loading="eager"
          decoding="async"
        />

        <div
          class="absolute right-1/2 bottom-2 z-40 w-[min(96%,320px)] translate-x-1/2 rounded-[1.25rem] border border-white/35 bg-[rgba(119,86,58,0.23)] p-2.5 shadow-[0_18px_36px_rgba(88,56,31,0.18)] backdrop-blur-md sm:bottom-3 sm:w-[min(92%,360px)] sm:rounded-[1.55rem] sm:p-3 md:w-[min(78%,420px)] xl:right-auto xl:bottom-5 xl:left-1/2 xl:w-[min(72%,430px)] xl:-translate-x-1/2 xl:rounded-[1.75rem]"
          data-reveal="scale"
        >
          <div
            class="grid grid-cols-1 items-center gap-2 sm:grid-cols-[1.1fr_0.9fr] sm:gap-3"
          >
            <a
              href="#project"
              class="rounded-full bg-[#f39a52] px-4 py-3 text-center text-base font-bold whitespace-nowrap text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.25)] transition hover:brightness-105 sm:px-6 sm:py-4 sm:text-lg xl:text-xl"
            >
              Portfolio ↗
            </a>
            <a
              href="#contact"
              class="text-center text-base font-medium text-white/88 transition hover:text-white sm:text-lg xl:text-xl"
            >
              Contact me
            </a>
          </div>
        </div>
      </div>

      <aside class="order-3 flex justify-center xl:justify-end">
        <div class="text-center xl:mt-8 xl:text-right" data-reveal>
          <div
            class="mb-3 flex justify-center gap-1 text-[#f39a52] xl:justify-end"
          >
            {
              stars.map(() => (
                <span class="text-[1.2rem] leading-none sm:text-[1.4rem] xl:text-[1.6rem]">
                  ★
                </span>
              ))
            }
          </div>
          <div
            class="text-[2.1rem] leading-none font-black tracking-[-0.05em] text-[#161616] sm:text-[2.6rem] xl:text-[3.2rem]"
          >
            5+ Years
          </div>
          <p
            class="mt-1 text-base font-medium text-[#3a3a3a] sm:text-[1.2rem] xl:text-[1.45rem]"
          >
            Experience
          </p>
        </div>
      </aside>
    </div>
  </section>
</div>
