---
import { Image } from "astro:assets"
import ArrowUpRightIcon from "@/components/ui/icons/arrow-up-right-icon.astro"
import heroImage from "@/assets/img/my-image.png"
import heroEllipse from "@/assets/img/Ellipse-2.png"
import helloSpark from "@/assets/img/Vector-1.png"
import accentStroke from "@/assets/img/Vector-2.png"

const stars = Array.from({ length: 5 })
---

<div class="px-3 pt-2 sm:px-4 sm:pt-3 md:px-6 lg:px-8 xl:px-10">
  <section
    id="home"
    data-nav-anchor="home"
    class="relative overflow-hidden px-0 pt-6 pb-0 sm:px-2 sm:pt-8 md:px-4 lg:px-6 xl:px-8"
  >
    <div class="relative z-20 mx-auto max-w-[980px] text-center">
      <div
        class="float-gentle relative z-20 inline-flex items-center gap-2 rounded-full border border-[#1d1d1d]/35 bg-white px-4 py-2 text-sm font-semibold text-[#1d1d1d] shadow-[0_8px_18px_rgba(0,0,0,0.05)] sm:gap-3 sm:px-5 md:text-base xl:text-lg"
        data-reveal="scale"
      >
        <span>Available for impactful work</span>
        <Image
          src={helloSpark}
          alt=""
          class="h-4 w-auto sm:h-5"
          widths={[24, 40]}
          sizes="(min-width: 640px) 20px, 16px"
          loading="eager"
          decoding="async"
        />
      </div>

      <h1
        class="mt-4 text-[2.55rem] leading-[0.95] font-black tracking-[-0.075em] text-[#141414] sm:text-[3.35rem] md:text-[4.15rem] lg:text-[4.9rem] xl:text-[5.45rem] 2xl:text-[6.1rem]"
        data-reveal
      >
        I'm <span class="text-[#b35a1a]">Hamzah</span><br />
        Front-End Developer
      </h1>
      <p
        class="mx-auto mt-5 max-w-[760px] text-sm leading-7 font-medium text-[#5f6b7d] sm:text-base sm:leading-8 lg:text-[1.05rem]"
        data-reveal
      >
        I build reliable frontend products for banking, payments, and internal
        business systems with strong attention to performance, testing, and
        maintainable UI architecture.
      </p>
    </div>

    <div
      class="relative mt-4 grid gap-6 md:mt-6 md:gap-8 lg:mt-8 xl:mt-6 xl:grid-cols-[minmax(220px,1fr)_minmax(560px,820px)_minmax(220px,1fr)] xl:items-center"
    >
      <aside class="order-2 flex justify-center xl:order-none xl:justify-start">
        <div class="max-w-[320px] text-center xl:mt-8 xl:text-left" data-reveal>
          <div
            class="mb-3 text-4xl leading-none font-black text-[#4b5563] sm:text-5xl"
          >
            “
          </div>
          <p
            class="text-sm leading-[1.55] font-semibold text-[#475569] sm:text-[15px] xl:text-base"
          >
            Experienced in building high-scale transaction flows, reusable UI
            systems, and frontend architecture that teams can ship on with
            confidence.
          </p>
        </div>
      </aside>

      <div
        class="relative order-1 mx-auto flex min-h-[390px] w-full max-w-[860px] items-end justify-center overflow-visible md:min-h-[500px] lg:min-h-[640px] xl:order-none xl:min-h-[760px]"
      >
        <Image
          src={accentStroke}
          alt=""
          class="float-slow absolute top-[5.9rem] left-[36%] z-40 w-7 -translate-x-1/2 md:top-[2.6rem] md:left-[38%] md:w-9 lg:top-[9.8rem] lg:left-[39%] lg:w-10 xl:top-[6.9rem] xl:left-[33%] xl:w-14 2xl:w-16"
          widths={[28, 36, 40, 56, 64]}
          sizes="(min-width: 1536px) 64px, (min-width: 1280px) 56px, (min-width: 1024px) 40px, (min-width: 768px) 36px, 28px"
          loading="eager"
          decoding="async"
        />
        <Image
          src={heroEllipse}
          alt=""
          class="absolute bottom-0 z-0 w-[88%] max-w-[255px] md:w-[96%] md:max-w-[360px] lg:w-[108%] lg:max-w-[480px] xl:w-[124%] xl:max-w-[700px]"
          data-reveal="scale"
          widths={[220, 320, 420, 640]}
          sizes="(min-width: 1280px) 700px, (min-width: 1024px) 480px, (min-width: 768px) 360px, 255px"
          format="webp"
          quality={42}
          loading="eager"
          decoding="async"
        />
        <Image
          src={heroImage}
          alt="Portrait illustration"
          class="absolute bottom-0 left-1/2 z-30 w-[55%] max-w-[220px] -translate-x-1/2 object-contain drop-shadow-[0_18px_30px_rgba(77,43,12,0.18)] md:w-[56%] md:max-w-[315px] lg:w-[58%] lg:max-w-[380px] lg:-bottom-4 xl:w-[66%] xl:max-w-[500px] xl:-bottom-6"
          data-reveal="scale"
          widths={[240, 320, 400, 500]}
          sizes="(min-width: 1280px) 400px, (min-width: 1024px) 360px, (min-width: 768px) 315px, 220px"
          format="avif"
          quality={48}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />

        <div
          class="absolute right-1/2 bottom-2 z-40 w-[min(92%,320px)] translate-x-1/2 rounded-[1.25rem] border border-white/35 bg-[rgba(119,86,58,0.23)] p-2.5 shadow-[0_18px_36px_rgba(88,56,31,0.18)] backdrop-blur-md sm:bottom-3 sm:w-[min(92%,360px)] sm:rounded-[1.55rem] sm:p-3 md:w-[min(74%,360px)] lg:w-[min(72%,360px)] xl:right-auto xl:bottom-5 xl:left-1/2 xl:w-[min(72%,430px)] xl:-translate-x-1/2 xl:rounded-[1.75rem]"
          data-reveal="scale"
        >
          <div
            class="grid grid-cols-1 items-center gap-2 sm:grid-cols-[1.1fr_0.9fr] sm:gap-3"
          >
            <a
              href="#project"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-[#8f4714] px-4 py-3 text-center text-base font-bold whitespace-nowrap text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.2)] transition hover:brightness-105 sm:px-6 sm:py-4 sm:text-lg xl:text-xl"
            >
              <span>Portfolio</span>
              <ArrowUpRightIcon class="h-5 w-5 sm:h-5.5 sm:w-5.5" />
            </a>
            <a
              href="#contact"
              class="text-center text-base font-medium text-white/88 transition hover:text-white sm:text-lg xl:text-xl"
            >
              Contact me
            </a>
          </div>
        </div>
      </div>

      <aside class="order-3 flex justify-center xl:justify-end mb-4 md:mb-5 lg:mb-0">
        <div class="text-center xl:mt-8 xl:text-right" data-reveal>
          <div
            class="mb-3 flex justify-center gap-1 text-[#b85f1d] xl:justify-end"
          >
            {
              stars.map(() => (
                <span class="text-[1.2rem] leading-none sm:text-[1.4rem] xl:text-[1.6rem]">
                  ★
                </span>
              ))
            }
          </div>
          <div
            class="text-[2.1rem] leading-none font-black tracking-[-0.05em] text-[#161616] sm:text-[2.6rem] xl:text-[3.2rem]"
          >
            5+ Years
          </div>
          <p
            class="mt-1 text-base font-medium text-[#3a3a3a] sm:text-[1.2rem] xl:text-[1.45rem]"
          >
            Experience
          </p>
        </div>
      </aside>
    </div>
  </section>
</div>
