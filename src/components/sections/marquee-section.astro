---
const skillItems = [
  "Vue (Quasar)",
  "React",
  "Next.js",
  "Vuex",
  "Redux",
  "Material UI",
  "TailwindCSS",
  "Jest",
  "React Testing Library",
  "gRPC",
  "REST API",
  "TypeScript",
  "Docker",
  "CI/CD",
  "Flask",
  "Django",
  "Node.js",
  "Express",
  "MySQL",
  "Figma",
]
---

<section class="bg-white px-4 py-6 sm:px-6 sm:py-8 lg:px-8 xl:px-10">
  <div class="mx-auto max-w-[1280px] overflow-hidden rounded-[1.35rem] border border-[#e6ebf2] bg-[#f5f7fb] py-4 sm:rounded-[1.7rem] sm:py-5 xl:rounded-[2rem]">
    <div class="flex min-w-max items-center gap-4 px-6 text-[0.95rem] font-semibold whitespace-nowrap text-[#33415c] sm:gap-5 sm:px-8 sm:text-[1.05rem] xl:text-[1.2rem]">
      {skillItems.map((item) => <span>{item}</span>)}
      <span class="text-[#f58a3a]">✦</span>
      {skillItems.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>
