---
import { Image } from "astro:assets"
import aboutImage from "@/assets/img/about-section-img.png"

const stats = [
  {
    value: "5+ Years",
    label: "Frontend Experience",
    valueClass:
      "text-[2.2rem] leading-[0.95] sm:text-[2.75rem] xl:text-[3rem]",
  },
  {
    value: "Banking & Payments",
    label: "Domain Focus",
    valueClass:
      "max-w-[10ch] text-[1.9rem] leading-[0.95] sm:text-[2.2rem] xl:text-[2.45rem]",
  },
]
---

<section id="about" class="bg-white px-4 sm:px-6 lg:px-8 xl:px-10">
  <div
    class="mx-auto grid max-w-[1240px] items-center gap-8 rounded-[1.6rem] bg-[#f3f6fb] px-4 py-8 sm:px-6 sm:py-10 md:px-8 lg:grid-cols-[0.95fr_1fr] lg:gap-10 lg:px-10 lg:py-12 xl:rounded-[2rem] xl:px-12"
  >
    <div
      class="relative mx-auto flex w-full max-w-[520px] items-end justify-center"
    >
      <!-- Background div -->
      <div
        class="absolute bottom-0 left-1/2 h-[76%] w-[66%] -translate-x-1/2 rounded-[2rem] bg-[#ffb36e] sm:h-[78%] sm:w-[68%] sm:rounded-[2.5rem] lg:h-[80%] lg:w-[70%] xl:rounded-[3rem]"
      >
      </div>

      <!-- Portrait image -->
      <Image
        src={aboutImage}
        alt="About section portrait"
        class="relative z-10 w-full max-w-[300px] object-contain sm:max-w-[380px] lg:max-w-[430px] xl:max-w-[470px]"
        width={470}
        sizes="(min-width: 1280px) 470px, (min-width: 1024px) 430px, (min-width: 640px) 380px, 300px"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="mx-auto w-full max-w-[520px] text-center lg:text-left">
      <h2
        class="text-[2.25rem] leading-[0.98] font-black tracking-[-0.07em] text-[#2f3b52] sm:text-[3rem] lg:text-[3.6rem] xl:text-[4.25rem]"
        data-reveal
      >
        Why <span class="text-[#ff8a37]">work with me</span><span
          class="text-[#2f3b52]">?</span
        >
      </h2>

      <p
        class="mt-5 max-w-[470px] text-base leading-[1.45] text-[#98a3b8] sm:mt-7 sm:text-[1.08rem] lg:max-w-[440px]"
        data-reveal
      >
        Frontend Developer based in Jakarta, Indonesia with 5+ years of
        experience building scalable and high-performance web applications. I
        bring together product thinking, reliable implementation, and strong
        engineering practices across React, Next.js, Vue, testing, API
        integration, and maintainable component systems.
      </p>

      <div
        class="mt-8 grid max-w-[520px] gap-6 sm:mt-10 sm:grid-cols-2 sm:gap-8"
      >
        {
          stats.map((stat) => (
            <div
              class="hover-lift flex min-h-[170px] flex-col justify-between rounded-[1.2rem] bg-white/70 p-5 shadow-[0_10px_25px_rgba(35,43,59,0.05)] sm:min-h-[190px] sm:p-6"
              data-reveal="scale"
            >
              <div class:list={[
                "text-left font-black tracking-[-0.06em] text-[#2f3b52]",
                stat.valueClass,
              ]}>
                {stat.value}
              </div>
              <p class="mt-4 text-left text-sm font-medium text-[#7d879c] sm:text-[1rem]">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>

      <a
        href="#contact"
        class="mt-8 inline-flex min-h-[58px] min-w-[170px] items-center justify-center rounded-[1.1rem] border border-[#4f5563] bg-white px-6 text-[1.2rem] font-black tracking-[-0.05em] text-[#151515] transition hover:border-[#151515] sm:mt-10 sm:min-h-[72px] sm:min-w-[200px] sm:rounded-[1.5rem] sm:px-8 sm:text-[1.5rem] xl:min-h-[104px] xl:min-w-[224px] xl:rounded-[2rem] xl:px-10 xl:text-[2rem]"
      >
        Let&apos;s connect
      </a>
    </div>
  </div>
</section>
