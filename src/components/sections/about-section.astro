---
import aboutImage from "@/assets/img/about-section-img.png"

const stats = [
  { value: "450+", label: "Project Completed" },
  { value: "450+", label: "Project Completed" },
]
---

<section id="about" class="bg-white px-4 sm:px-6 lg:px-8">
  <div
    class="mx-auto grid max-w-[1240px] items-center gap-8 rounded-[2rem] bg-[#f3f6fb] px-4 py-8 sm:px-8 sm:py-10 lg:grid-cols-[1.02fr_1fr] lg:gap-10 lg:px-12 lg:py-12"
  >
    <div class="relative mx-auto flex w-full max-w-[520px] justify-center">
      <div
        class="absolute bottom-2 left-1/2 h-[76%] w-[66%] -translate-x-1/2 rounded-[2.2rem] bg-[#ffb36e] sm:rounded-[3rem]"
      >
      </div>
      <img
        src={aboutImage.src}
        alt="About section portrait"
        class="relative z-10 w-full max-w-[340px] object-contain sm:max-w-[470px]"
      />
    </div>

    <div class="mx-auto w-full max-w-[520px] text-center lg:text-left">
      <h2
        class="text-[2.8rem] leading-[0.95] font-black tracking-[-0.07em] text-[#2f3b52] sm:text-[4.25rem]"
      >
        Why <span class="text-[#ff8a37]">Hire me</span><span
          class="text-[#2f3b52]">?</span
        >
      </h2>

      <p
        class="mt-5 max-w-[470px] text-base leading-[1.45] text-[#98a3b8] sm:mt-7 sm:text-[1.08rem] lg:max-w-[440px]"
      >
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis lacus
        nunc, posuere in justo vulputate, bibendum sodales
      </p>

      <div
        class="mt-8 grid max-w-[520px] gap-6 sm:mt-10 sm:grid-cols-2 sm:gap-8"
      >
        {
          stats.map((stat) => (
            <div>
              <div class="text-[2.35rem] leading-none font-black tracking-[-0.06em] text-[#2f3b52] sm:text-[3.15rem]">
                {stat.value}
              </div>
              <p class="mt-2 text-sm font-medium text-[#7d879c] sm:mt-3 sm:text-[1rem]">
                {stat.label}
              </p>
            </div>
          ))
        }
      </div>

      <a
        href="#contact"
        class="mt-8 inline-flex min-h-[78px] min-w-[180px] items-center justify-center rounded-[1.4rem] border border-[#4f5563] bg-white px-8 text-[1.6rem] font-black tracking-[-0.05em] text-[#151515] transition hover:border-[#151515] sm:mt-10 sm:min-h-[104px] sm:min-w-[224px] sm:rounded-[2rem] sm:px-10 sm:text-[2rem]"
      >
        Hire me
      </a>
    </div>
  </div>
</section>
