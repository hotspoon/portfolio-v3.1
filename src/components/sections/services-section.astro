---
import serviceBg from "@/assets/img/service-bg.png"

const serviceCards = [
  {
    title: "UI/UX Design",
    featured: false,
    preview: "home",
  },
  {
    title: "Web Design",
    featured: true,
    preview: "food",
  },
  {
    title: "Landing Page",
    featured: false,
    preview: "home",
  },
]
---

<section
  id="service"
  class="relative overflow-hidden px-4 py-10 text-white sm:px-6 lg:px-8"
  style={`background-image: url(${serviceBg.src}); background-size: cover; background-position: center;`}
>
  <div class="absolute inset-0 rounded-[2.5rem] bg-[#121212]/88"></div>

  <div class="relative z-10 mx-auto max-w-270">
    <div class="mb-8 grid items-start gap-5 lg:grid-cols-[1fr_420px]">
      <h2
        class="text-[2.55rem] leading-none font-black tracking-[-0.065em] text-white"
      >
        My <span class="text-[#f39a52]">Services</span>
      </h2>
      <p class="pt-1 text-[15px] leading-[1.45] text-white/82 lg:text-left">
        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Duis lacus
        nunc, posuere in justo vulputate, bibendum sodales.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {
        serviceCards.map((card) => (
          <article
            class:list={[
              "relative rounded-[2rem] border bg-[linear-gradient(180deg,rgba(255,255,255,0.08)_0%,rgba(255,255,255,0.03)_100%)] pt-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]",
              card.featured
                ? "border-[#7d4dff] shadow-[0_0_0_1px_rgba(125,77,255,0.7)]"
                : "border-white/22",
            ]}
          >
            <div class="px-6 pb-5 text-[1.1rem] font-semibold text-white">
              {card.title}
            </div>
            <div class="h-px w-full bg-white/18" />
            <div class="relative overflow-hidden px-4 pt-9 pb-6">
              <div class="absolute top-5 right-6 left-6 h-8 rounded-t-[1.65rem] bg-[#8c8c8c]/36 blur-[0.5px]" />
              <div class="absolute top-10 right-7 h-18 w-18 rounded-full bg-white/28 blur-xl" />
              <div class="rounded-[1.55rem] bg-white/94 px-3 pt-5 pb-3 shadow-[0_16px_30px_rgba(0,0,0,0.14)]">
                {card.preview === "food" ? (
                  <div class="grid min-h-[250px] grid-cols-[68px_1fr_46px] items-end gap-3">
                    <div class="rounded-[1rem] bg-white p-2 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.8rem] border border-[#ece8e2] bg-[#fffdfa] p-2">
                        <div class="mb-2 h-2 w-8 rounded-full bg-[#171717]/10" />
                        <div class="space-y-2">
                          <div class="h-10 rounded-[0.75rem] bg-[#f5c58d]" />
                          <div class="h-2 rounded-full bg-[#171717]/10" />
                          <div class="h-2 w-3/4 rounded-full bg-[#f39a52]/60" />
                          <div class="h-6 rounded-full bg-[#171717]/92" />
                        </div>
                      </div>
                    </div>
                    <div class="rounded-[1.15rem] bg-white p-2 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.95rem] border border-[#ece8e2] bg-[#fffdfa] p-3">
                        <div class="mb-3 flex items-center justify-between">
                          <div class="h-2 w-12 rounded-full bg-[#171717]/12" />
                          <div class="flex gap-1">
                            <div class="h-2 w-2 rounded-full bg-[#171717]/18" />
                            <div class="h-2 w-2 rounded-full bg-[#f39a52]/65" />
                          </div>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                          <div class="space-y-2 rounded-[0.9rem] bg-[#fff6ef] p-2">
                            <div class="h-8 rounded-[0.7rem] bg-[#f3b069]" />
                            <div class="h-2 rounded-full bg-[#171717]/12" />
                            <div class="h-2 w-4/5 rounded-full bg-[#171717]/12" />
                          </div>
                          <div class="space-y-2 rounded-[0.9rem] bg-[#fff6ef] p-2">
                            <div class="h-8 rounded-[0.7rem] bg-[#f39a52]" />
                            <div class="h-2 rounded-full bg-[#171717]/12" />
                            <div class="h-2 w-4/5 rounded-full bg-[#171717]/12" />
                          </div>
                          <div class="col-span-2 rounded-[1rem] bg-[#fff3e6] p-3">
                            <div class="mb-2 h-3 w-20 rounded-full bg-[#171717]/12" />
                            <div class="flex items-end gap-3">
                              <div class="h-10 w-10 rounded-full bg-[#f0b06e]" />
                              <div class="h-14 flex-1 rounded-[1rem] bg-[#f39a52]" />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="rounded-[1rem] bg-white p-1.5 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.8rem] border border-[#ece8e2] bg-[#fffdfa] p-2">
                        <div class="mb-2 h-2 rounded-full bg-[#171717]/10" />
                        <div class="space-y-1.5">
                          <div class="h-6 rounded-[0.7rem] bg-[#fff1de]" />
                          <div class="h-6 rounded-[0.7rem] bg-[#fff1de]" />
                          <div class="h-6 rounded-[0.7rem] bg-[#fff1de]" />
                        </div>
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="grid min-h-[250px] grid-cols-[58px_1fr_58px] items-end gap-3">
                    <div class="rounded-[1rem] bg-white p-2 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.8rem] border border-[#ece8e2] bg-[#fffdfa] p-2">
                        <div class="mb-2 h-2 rounded-full bg-[#171717]/10" />
                        <div class="space-y-2">
                          <div class="h-16 rounded-[0.85rem] bg-[#c4ad8f]" />
                          <div class="grid grid-cols-2 gap-1.5">
                            <div class="h-5 rounded-[0.55rem] bg-[#f3ede5]" />
                            <div class="h-5 rounded-[0.55rem] bg-[#f3ede5]" />
                          </div>
                          <div class="h-2 w-3/4 rounded-full bg-[#171717]/12" />
                        </div>
                      </div>
                    </div>
                    <div class="rounded-[1.15rem] bg-white p-2 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.95rem] border border-[#ece8e2] bg-[#fffdfa] p-3">
                        <div class="mb-3 flex items-center justify-between">
                          <div class="h-2 w-14 rounded-full bg-[#171717]/12" />
                          <div class="h-2 w-8 rounded-full bg-[#f2b86d]/80" />
                        </div>
                        <div class="space-y-2">
                          <div class="grid grid-cols-2 gap-2">
                            <div class="h-20 rounded-[0.85rem] bg-[#c8b294]" />
                            <div class="h-20 rounded-[0.85rem] bg-[#bfa588]" />
                          </div>
                          <div class="rounded-[0.9rem] bg-[#efe7dd] p-2">
                            <div class="mb-2 grid grid-cols-2 gap-2">
                              <div class="h-8 rounded-[0.7rem] bg-white" />
                              <div class="h-8 rounded-[0.7rem] bg-[#f5ca95]" />
                            </div>
                            <div class="h-2 rounded-full bg-[#171717]/12" />
                          </div>
                          <div class="h-7 rounded-full bg-[#171717]/88" />
                        </div>
                      </div>
                    </div>
                    <div class="rounded-[1rem] bg-white p-2 shadow-[0_10px_18px_rgba(0,0,0,0.08)]">
                      <div class="rounded-[0.8rem] border border-[#ece8e2] bg-[#fffdfa] p-2">
                        <div class="mb-2 h-2 rounded-full bg-[#171717]/10" />
                        <div class="space-y-2">
                          <div class="h-16 rounded-[0.85rem] bg-[#c4ad8f]" />
                          <div class="grid grid-cols-2 gap-1.5">
                            <div class="h-5 rounded-[0.55rem] bg-[#f3ede5]" />
                            <div class="h-5 rounded-[0.55rem] bg-[#f3ede5]" />
                          </div>
                          <div class="h-2 w-3/4 rounded-full bg-[#171717]/12" />
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
              <div class="absolute right-3 bottom-1 flex h-[5.1rem] w-[5.1rem] items-center justify-center rounded-full bg-[#1c2941] text-[2.35rem] text-white shadow-[0_14px_24px_rgba(13,21,39,0.5)]">
                ↗
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-6 flex items-center justify-center gap-2.5">
      <span class="h-2.5 w-10 rounded-full bg-[#f39a52]"></span>
      <span class="h-3 w-3 rounded-full bg-white/95"></span>
      <span class="h-3 w-3 rounded-full bg-white/85"></span>
      <span class="h-3 w-3 rounded-full bg-white/55"></span>
    </div>
  </div>
</section>
