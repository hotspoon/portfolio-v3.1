---
const experiences = [
  {
    company: "PT Bank Rakyat Indonesia Tbk",
    date: "October 2025 - Present",
    role: "Frontend Developer",
    desc: "Developed frontend features for the NDS Payment Engine, built end-to-end payment flows, and created reusable UI and integration adapters using Vue, Vuex, gRPC, and REST APIs.",
    active: "orange",
  },
  {
    company: "PT Bank Maybank Indonesia Tbk",
    date: "February 2025 - September 2025",
    role: "Frontend Developer",
    desc: "Developed the Multicurrency feature in M2U ID Web using React, Material UI, and Redux for Maybank's web-based digital banking application.",
    active: "dark",
  },
  {
    company: "PT Telkom Indonesia",
    date: "July 2024 - September 2024",
    role: "Frontend Developer",
    desc: "Developed Portal Klinik modules with React and Next.js, added unit and integration tests, improved validation and performance, and supported Docker plus CI/CD workflows.",
    active: "orange",
  },
  {
    company: "PT GDC Multi Sarana",
    date: "November 2020 - April 2024",
    role: "Frontend Developer",
    desc: "Led fullstack development for payment gateway products, built GDCPay SSO Web Admin, and developed APIs with Flask, Django, Node.js, Express, and MySQL.",
    active: "dark",
  },
  {
    company: "Machine Vision Indonesia",
    date: "November 2018 - April 2019",
    role: "Frontend Developer",
    desc: "Developed webpages with VueJS, integrated REST APIs, and supported backend functionality using PHP Laravel to improve system efficiency and user engagement.",
    active: "orange",
  },
]
---

<section id="resume" class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 xl:px-10">
  <div class="mx-auto max-w-[1180px]">
    <div class="text-center">
      <h2
        class="text-[2.2rem] leading-[1.05] font-black tracking-[-0.06em] text-[#243244] sm:text-[2.8rem] lg:text-[3.2rem] 2xl:text-[3.5rem]"
      >
        My <span class="text-[#f39a52]">Work Experience</span>
      </h2>
    </div>

    <div class="mt-10 grid gap-y-6 sm:mt-14 sm:gap-y-8 xl:mt-16 xl:gap-y-10">
      {
        experiences.map((item, index) => (
          <div class="rounded-[1.5rem] border border-[#e7ecf3] bg-[#f8fafc] p-5 shadow-[0_8px_24px_rgba(35,43,59,0.05)] sm:p-6 xl:grid xl:grid-cols-[minmax(0,1fr)_90px_minmax(0,1fr)] xl:items-start xl:gap-x-14 xl:rounded-[2rem] xl:border-none xl:bg-transparent xl:p-0 xl:shadow-none">
            <div class="text-left">
              <h3 class="text-[1.65rem] leading-[1.08] font-black tracking-[-0.05em] text-[#243244] sm:text-[2rem] xl:text-3xl">
                {item.company}
              </h3>
              <p class="mt-2 text-sm text-[#97a1b2] sm:text-base xl:text-[1.1rem]">
                {item.date}
              </p>
            </div>

            <div class="relative mx-auto hidden h-full w-[90px] justify-center xl:flex">
              {index !== experiences.length - 1 && (
                <div class="absolute top-8 bottom-[-3.5rem] left-1/2 w-px -translate-x-1/2 border-l-2 border-dashed border-[#3b4354]" />
              )}

              <div
                class:list={[
                  "relative z-10 mt-1 h-10 w-10 rounded-full border-4 border-white shadow-[0_0_0_2px_#3b4354]",
                  item.active === "dark" ? "bg-[#243244]" : "bg-[#f39a52]",
                ]}
              />
            </div>

            <div class="mt-4 border-t border-[#e4e9f0] pt-4 text-left xl:mt-0 xl:border-t-0 xl:pt-0">
              <h3 class="text-[1.65rem] leading-[1.08] font-black tracking-[-0.05em] text-[#243244] sm:text-[2rem] xl:text-3xl">
                {item.role}
              </h3>
              {item.desc && (
                <p class="mt-2 max-w-[520px] text-sm leading-6 text-[#97a1b2] sm:text-base sm:leading-7 xl:max-w-[420px] xl:text-[1.1rem] xl:leading-8">
                  {item.desc}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
