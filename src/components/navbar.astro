---
import { Image } from "astro:assets"
import logo from "@/assets/img/jcrea-nav-logo-v2.png"

const links = [
  { href: "#home", label: "Home", active: true },
  { href: "#about", label: "About" },
  { href: "#service", label: "Focus" },
  { href: "#resume", label: "Resume" },
  { href: "#project", label: "Work" },
  { href: "#contact", label: "Contact" },
]
---

<nav
  class="flex w-full max-w-[1280px] flex-wrap items-center justify-center gap-2 rounded-[1.35rem] bg-[#151515] px-3 py-2 text-white shadow-[0_18px_45px_rgba(17,17,17,0.16)] sm:rounded-[1.7rem] sm:px-4 md:gap-3 lg:flex-nowrap lg:justify-between lg:px-5 xl:px-6"
>
  <div
    class="flex flex-wrap items-center justify-center gap-2 md:justify-start"
  >
    {
      links.slice(0, 3).map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-full px-3 py-2 text-xs font-medium tracking-[0.01em] transition duration-200 hover:bg-white/10 sm:px-4 sm:text-sm xl:px-5 xl:py-2.5",
            link.active &&
              "bg-[#b85f1d] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.22)]",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <a
    href="#home"
    class="order-first flex items-center gap-2 rounded-full px-3 py-2 md:order-none"
  >
    <Image
      src={logo}
      alt="Hamzah logo"
      class="h-8 w-8 object-contain sm:h-9 sm:w-9"
      width={36}
      sizes="36px"
      loading="eager"
      decoding="async"
    />
    <span
      class="text-[1.15rem] font-extrabold tracking-[0.04em] sm:text-[1.35rem] xl:text-[1.7rem]"
      >HAMZAH</span
    >
  </a>

  <div class="flex flex-wrap items-center justify-center gap-2 md:justify-end">
    {
      links.slice(3).map((link) => (
        <a
          href={link.href}
          class="rounded-full px-3 py-2 text-xs font-medium tracking-[0.01em] transition duration-200 hover:bg-white/10 sm:px-4 sm:text-sm xl:px-5 xl:py-2.5"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>
