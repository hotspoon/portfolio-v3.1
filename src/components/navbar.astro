---
import { Image } from "astro:assets"
import ArrowUpRightIcon from "@/components/ui/icons/arrow-up-right-icon.astro"
import logo from "@/assets/img/jcrea-nav-logo-v2.png"

const cvHref =
  "https://drive.google.com/file/d/169BZtUsVHyvkzTF5pwoow2BWyuMJi4jg/view?usp=drive_link"

const links = [
  { href: "#home", label: "Home", active: true },
  { href: "#service", label: "Focus" },
  { href: "#resume", label: "Experience" },
  { href: "#about", label: "About" },
  { href: "#project", label: "Work" },
  { href: "#contact", label: "Contact" },
]
---

<nav
  class="mx-auto w-full max-w-[1280px] rounded-[1.35rem] bg-[#151515] px-3 py-2 text-white shadow-[0_18px_45px_rgba(17,17,17,0.16)] sm:rounded-[1.7rem] sm:px-4 lg:px-5 xl:px-6"
>
  <div class="flex items-center justify-between gap-3 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:gap-6">
    <div class="hidden lg:flex lg:flex-wrap lg:items-center lg:justify-start lg:gap-2 xl:gap-3">
      {
        links.slice(0, 3).map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-full px-3 py-2 text-xs font-medium tracking-[0.01em] transition duration-200 hover:bg-white/10 sm:px-4 sm:text-sm xl:px-5 xl:py-2.5",
              link.active &&
                "bg-[#8f4714] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.16)]",
            ]}
            data-nav-link
            data-nav-target={link.href.slice(1)}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="#home"
      class="flex items-center gap-2 rounded-full px-3 py-2 lg:justify-self-center"
    >
      <Image
        src={logo}
        alt="Hamzah logo"
        class="h-8 w-8 object-contain sm:h-9 sm:w-9"
        widths={[36, 72]}
        sizes="36px"
        loading="eager"
        decoding="async"
      />
      <span
        class="text-[1.15rem] font-extrabold tracking-[0.04em] sm:text-[1.35rem] xl:text-[1.7rem]"
        >HAMZAH</span
      >
    </a>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/12 bg-white/6 text-white transition hover:bg-white/10 lg:hidden"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav-menu"
      data-mobile-nav-toggle
    >
      <span class="sr-only">Toggle navigation</span>
      <span class="relative h-4 w-5">
        <span class="absolute top-0 left-0 h-0.5 w-5 rounded-full bg-current transition-transform duration-200" data-mobile-nav-line="top"></span>
        <span class="absolute top-[7px] left-0 h-0.5 w-5 rounded-full bg-current transition-opacity duration-200" data-mobile-nav-line="middle"></span>
        <span class="absolute top-[14px] left-0 h-0.5 w-5 rounded-full bg-current transition-transform duration-200" data-mobile-nav-line="bottom"></span>
      </span>
    </button>

    <div class="hidden lg:flex lg:flex-wrap lg:items-center lg:justify-end lg:gap-2 xl:gap-3">
      {
        links.slice(3).map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-2 text-xs font-medium tracking-[0.01em] transition duration-200 hover:bg-white/10 sm:px-4 sm:text-sm xl:px-5 xl:py-2.5"
            data-nav-link
            data-nav-target={link.href.slice(1)}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={cvHref}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full bg-[#8f4714] px-3 py-2 text-xs font-semibold tracking-[0.01em] text-white transition hover:brightness-105 sm:px-4 sm:text-sm xl:px-5 xl:py-2.5"
      >
        <span>View CV</span>
        <ArrowUpRightIcon class="h-4 w-4" />
      </a>
    </div>
  </div>

  <div
    id="mobile-nav-menu"
    class="hidden border-t border-white/10 pt-3 pb-1 lg:hidden"
    data-mobile-nav-menu
  >
    <div class="grid gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-[1rem] px-4 py-3 text-sm font-medium tracking-[0.01em] transition duration-200 hover:bg-white/10",
              link.active && "bg-[#8f4714] text-white",
            ]}
            data-mobile-nav-link
            data-nav-link
            data-nav-target={link.href.slice(1)}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={cvHref}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-[1rem] bg-[#8f4714] px-4 py-3 text-sm font-semibold text-white transition hover:brightness-105"
      >
        <span>View CV</span>
        <ArrowUpRightIcon class="h-4 w-4" />
      </a>
    </div>
  </div>
</nav>

<script>
  const initMobileNav = () => {
    const activeClasses = [
      "bg-[#8f4714]",
      "text-white",
      "shadow-[inset_0_1px_0_rgba(255,255,255,0.16)]",
    ]

    const setActiveLink = (targetId: string) => {
      document.querySelectorAll("[data-nav-link]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return

        const isActive = link.dataset.navTarget === targetId
        activeClasses.forEach((className) => {
          link.classList.toggle(className, isActive)
        })
      })
    }

    const navs = document.querySelectorAll("nav")

    navs.forEach((nav) => {
      if (!(nav instanceof HTMLElement)) return
      if (nav.dataset.navReady === "true") return
      nav.dataset.navReady = "true"

      const toggle = nav.querySelector("[data-mobile-nav-toggle]")
      const menu = nav.querySelector("[data-mobile-nav-menu]")
      const links = nav.querySelectorAll("[data-mobile-nav-link]")
      if (!(toggle instanceof HTMLButtonElement)) return
      if (!(menu instanceof HTMLElement)) return

      const top = toggle.querySelector('[data-mobile-nav-line="top"]')
      const middle = toggle.querySelector('[data-mobile-nav-line="middle"]')
      const bottom = toggle.querySelector('[data-mobile-nav-line="bottom"]')

      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", open ? "true" : "false")
        menu.classList.toggle("hidden", !open)
        top?.classList.toggle("translate-y-[7px]", open)
        top?.classList.toggle("rotate-45", open)
        middle?.classList.toggle("opacity-0", open)
        bottom?.classList.toggle("-translate-y-[7px]", open)
        bottom?.classList.toggle("-rotate-45", open)
      }

      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true"
        setOpen(!isOpen)
      })

      links.forEach((link) => {
        link.addEventListener("click", () => setOpen(false))
      })
    })

    if (document.documentElement.dataset.navbarActiveReady === "true") {
      return
    }
    document.documentElement.dataset.navbarActiveReady = "true"

    let pendingTargetId: string | null = null
    let pendingTargetUntil = 0

    const anchorIds = ["home", "service", "resume", "about", "project", "contact"]
    const anchors = anchorIds
      .map((id) => document.getElementById(id))
      .filter((anchor): anchor is HTMLElement => anchor instanceof HTMLElement)

    document.querySelectorAll("[data-nav-link]").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return

      link.addEventListener("click", () => {
        const targetId = link.dataset.navTarget
        if (!targetId) return
        pendingTargetId = targetId
        pendingTargetUntil = window.performance.now() + 1200
        setActiveLink(targetId)
      })
    })

    const updateFromHash = () => {
      const hashTarget = window.location.hash.replace("#", "") || "home"
      setActiveLink(hashTarget)
    }

    if (anchors.length > 0) {
      const updateFromScroll = () => {
        const stickyShell = document.querySelector("[data-sticky-nav-shell]")
        const shellHeight =
          stickyShell instanceof HTMLElement
            ? stickyShell.getBoundingClientRect().height
            : 0
        const marker = shellHeight + 40

        if (pendingTargetId) {
          const pendingAnchor = anchors.find((anchor) => anchor.id === pendingTargetId)

          if (pendingAnchor) {
            const rect = pendingAnchor.getBoundingClientRect()
            const hasReachedTarget =
              rect.top <= marker + 8 && rect.bottom >= marker - 8

            if (hasReachedTarget || window.performance.now() > pendingTargetUntil) {
              pendingTargetId = null
            } else {
              setActiveLink(pendingAnchor.id || "home")
              return
            }
          } else {
            pendingTargetId = null
          }
        }

        let activeAnchor = anchors[0]

        anchors.forEach((anchor) => {
          const rect = anchor.getBoundingClientRect()
          if (rect.top <= marker) {
            activeAnchor = anchor
          }
        })

        const targetId = activeAnchor.id || "home"
        setActiveLink(targetId)
      }

      window.addEventListener("scroll", updateFromScroll, { passive: true })
      updateFromScroll()
    }

    window.addEventListener("hashchange", updateFromHash)
    updateFromHash()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileNav, { once: true })
  } else {
    initMobileNav()
  }

  document.addEventListener("astro:page-load", initMobileNav)
</script>
